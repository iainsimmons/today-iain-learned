---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import RollPage from '@/components/RollPage.astro';
import { generateCustomPageSEO } from '@/utils/seo';

const podrollEntries = await getCollection('podroll');
const groups = podrollEntries[0]?.data.groups || [];
const lastUpdated = podrollEntries[0]?.data.lastUpdated;

const seoData = generateCustomPageSEO(
  {
    title: 'Podroll',
    description: 'A collection of the podcasts that I listen to.',
  },
  Astro.url.pathname
);

// Create TOC headings from group titles
const toc = groups.map(group => ({
  depth: 2 as number,
  slug: group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''),
  text: group.title
}));

const shouldShowTOC = toc.length > 1;
---

<BaseLayout seoData={seoData} hasTOC={shouldShowTOC}>
  <RollPage
    title="Podroll"
    description="Here is an up-to-date collection of the podcasts that I listen to, grouped by topic."
    seeAlsoLinkText="Blogroll"
    seeAlsoLink="/blogroll/"
    seeAlsoDescription="for a list of blogs I subscribe to"
    toc={toc}
    groups={groups}
    lastUpdated={lastUpdated}
    hasTOC={shouldShowTOC}
  />
  {shouldShowTOC && (
    <div class="toc-sidebar">
      <div class="toc-sticky" id="toc">
        <TableOfContents headings={toc} />
      </div>
    </div>
  )}
</BaseLayout>
