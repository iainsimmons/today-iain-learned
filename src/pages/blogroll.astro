---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import RollPage from '@/components/RollPage.astro';
import { generateCustomPageSEO } from '@/utils/seo';

const blogrollEntries = await getCollection('blogroll');
const groups = blogrollEntries[0]?.data.groups || [];
const lastUpdated = blogrollEntries[0]?.data.lastUpdated;

const seoData = generateCustomPageSEO(
  {
    title: 'Blogroll',
    description: 'A collection of the RSS feeds that I subscribe to.',
  },
  Astro.url.pathname
);

// Create TOC headings from group titles
const toc = groups.map(group => ({
  depth: 2 as number,
  slug: group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''),
  text: group.title
}));

const shouldShowTOC = toc.length > 1;
---

<BaseLayout seoData={seoData} hasTOC={shouldShowTOC}>
  <RollPage
    title="Blogroll"
    description="Here is an up-to-date collection of the RSS feeds that I subscribe to, grouped by topic."
    seeAlsoLinkText="Podroll"
    seeAlsoLink="/podroll/"
    seeAlsoDescription="for a list of podcasts I listen to"
    toc={toc}
    groups={groups}
    lastUpdated={lastUpdated}
    hasTOC={shouldShowTOC}
  />
  {shouldShowTOC && (
    <div class="toc-sidebar">
      <div class="toc-sticky" id="toc">
        <TableOfContents headings={toc} />
      </div>
    </div>
  )}
</BaseLayout>
