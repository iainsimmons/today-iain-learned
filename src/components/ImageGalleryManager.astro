<script>
  declare global {
    interface Window {
      initializeImageGalleries: () => void;
      lightboxInstance: any;
    }
  }
  
  function initializeImageGalleries() {
    const contentElement = document.querySelector('.prose');
    if (!contentElement) {
      return;
    }
    const paragraphs = contentElement.querySelectorAll('p');
    
    const imageParagraphs: { paragraph: Element; index: number; imageCount: number }[] = [];
    paragraphs.forEach((para, index) => {
      const images = Array.from(para.querySelectorAll('img'));
      const nonLinkedImages = images.filter(img => !img.closest('a'));
      if (nonLinkedImages.length > 0) {
        imageParagraphs.push({ paragraph: para, index: index, imageCount: nonLinkedImages.length });
      }
    });
    
    imageParagraphs.forEach((paraInfo) => {
      const { paragraph, imageCount } = paraInfo;
      
      if (imageCount >= 1) {
        const galleryContainer = document.createElement('div');
        
        if (imageCount === 1) {
          galleryContainer.className = 'image-gallery image-gallery-1';
        } else if (imageCount === 2) {
          galleryContainer.className = 'image-gallery image-gallery-2';
        } else if (imageCount === 3) {
          galleryContainer.className = 'image-gallery image-gallery-3';
        } else if (imageCount >= 4) {
          galleryContainer.className = 'image-gallery image-gallery-4';
        }
        
        const allImages = Array.from(paragraph.querySelectorAll('img'));
        const images = allImages.filter(img => !img.closest('a'));
        
        let nonImageContent: Node[] = [];
        if (imageCount === 1) {
          nonImageContent = Array.from(paragraph.childNodes).filter(node => {
            if (node.nodeType === Node.ELEMENT_NODE) {
              const element = node as Element;
              return element.tagName !== 'IMG' && element.tagName !== 'PICTURE';
            }
            if (node.nodeType === Node.TEXT_NODE) {
              return (node.textContent || '').trim() !== '';
            }
            return true;
          });
          
          if (nonImageContent.length === 0) {
            const nextParagraph = paragraph.nextElementSibling;
            if (nextParagraph && nextParagraph.tagName === 'P') {
              const hasItalic = nextParagraph.querySelector('em, i');
              const hasLinks = nextParagraph.querySelector('a');
              const isHeading = nextParagraph.querySelector('h1, h2, h3, h4, h5, h6');
              const hasOnlyText = nextParagraph.textContent && nextParagraph.textContent.trim() !== '' && 
                                nextParagraph.children.length <= 2;
              
              if ((hasItalic || hasLinks || hasOnlyText) && !isHeading) {
                nonImageContent = Array.from(nextParagraph.childNodes);
                (nextParagraph as HTMLElement).style.display = 'none';
              }
            }
          }
        }
        
        images.forEach((img, imgIndex) => {
          const imageItem = document.createElement('div');
          imageItem.className = 'image-item';
          
          const button = document.createElement('button');
          button.className = 'image-button';
          button.setAttribute('data-lightbox', 'gallery');
          button.setAttribute('aria-label', `View ${img.alt} in full size`);
          
          button.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('openLightbox', {
              detail: { index: imgIndex, button: button }
            }));
          });
          
          const imgClone = img.cloneNode(true) as HTMLImageElement;
          imgClone.className = 'image-gallery-img';
          imgClone.loading = 'lazy';
          imgClone.setAttribute('data-lightbox', 'gallery');
          
          const overlay = document.createElement('div');
          overlay.className = 'image-button-overlay';
          
          const zoomIcon = document.createElement('div');
          zoomIcon.className = 'image-button-icon';
          zoomIcon.innerHTML = `
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
            </svg>
          `;
          
          overlay.appendChild(zoomIcon);
          button.appendChild(imgClone);
          button.appendChild(overlay);
          imageItem.appendChild(button);
          galleryContainer.appendChild(imageItem);
        });
        
        const container = document.createElement('div');
        container.className = 'image-container';
        container.appendChild(galleryContainer);
        
        if (nonImageContent.length > 0) {
          const captionContainer = document.createElement('div');
          captionContainer.className = 'image-caption-container';
          nonImageContent.forEach(node => {
            if (node.nodeType === Node.TEXT_NODE && (!node.textContent || !node.textContent.trim())) {
              return;
            }
            if (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName === 'BR') {
              return;
            }
            captionContainer.appendChild(node.cloneNode(true));
          });
          container.appendChild(captionContainer);
        }
        
        paragraph.parentNode?.replaceChild(container, paragraph);
      }
    });
  }
  
  document.addEventListener('DOMContentLoaded', initializeImageGalleries);
  
  window['initializeImageGalleries'] = initializeImageGalleries;
</script>

<style is:global>
  .image-gallery-1 {
    margin: 0.5rem 0;
  }
  
  .image-gallery-2,
  .image-gallery-3,
  .image-gallery-4 {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
  }
  
  .image-gallery-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .image-gallery-3 {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .image-gallery-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .image-gallery-4 {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .image-gallery-4 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .image-gallery-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .image-gallery-1 .image-item,
  .image-gallery-2 .image-item,
  .image-gallery-3 .image-item,
  .image-gallery-4 .image-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  
  .image-gallery-1 .image-button,
  .image-gallery-2 .image-button,
  .image-gallery-3 .image-button,
  .image-gallery-4 .image-button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .image-gallery-1 .image-gallery-img,
  .image-gallery-2 .image-gallery-img,
  .image-gallery-3 .image-gallery-img,
  .image-gallery-4 .image-gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.5rem;
    transition: all 300ms var(--default-easing);
  }
  
  .image-gallery-1 .image-button:hover .image-gallery-img,
  .image-gallery-2 .image-button:hover .image-gallery-img,
  .image-gallery-3 .image-button:hover .image-gallery-img,
  .image-gallery-4 .image-button:hover .image-gallery-img {
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    scale: 1.02;
  }

  .image-gallery-1 .image-button-overlay,
  .image-gallery-2 .image-button-overlay,
  .image-gallery-3 .image-button-overlay,
  .image-gallery-4 .image-button-overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0);
    transition: background-color 300ms var(--default-easing);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-gallery-1 .image-button:hover .image-button-overlay,
  .image-gallery-2 .image-button:hover .image-button-overlay,
  .image-gallery-3 .image-button:hover .image-button-overlay,
  .image-gallery-4 .image-button:hover .image-button-overlay {
    background-color: rgb(0 0 0 / 0.1);
  }

  .image-gallery-1 .image-button-icon,
  .image-gallery-2 .image-button-icon,
  .image-gallery-3 .image-button-icon,
  .image-gallery-4 .image-button-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: rgb(255 255 255);
    opacity: 0;
    transition: opacity 300ms var(--default-easing);
  }

  .image-gallery-1 .image-button:hover .image-button-icon,
  .image-gallery-2 .image-button:hover .image-button-icon,
  .image-gallery-3 .image-button:hover .image-button-icon,
  .image-gallery-4 .image-button:hover .image-button-icon {
    opacity: 1;
  }
  
  .image-gallery-3 .image-item:first-child {
    grid-column: span 2;
  }
  
  .image-gallery-4 .image-item:nth-child(4n+1) {
    aspect-ratio: 1 / 1;
  }
  
  .image-gallery-4 .image-item:nth-child(4n+2) {
    aspect-ratio: 4 / 3;
  }
  
  .image-gallery-4 .image-item:nth-child(4n+3) {
    aspect-ratio: 16 / 9;
  }
  
  .image-gallery-4 .image-item:nth-child(4n) {
    aspect-ratio: 3 / 4;
  }
</style>
