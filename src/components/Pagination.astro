---
import type { PaginationInfo } from '@/types';
import Icon from './Icon.astro';

export interface Props {
  pagination: PaginationInfo;
  baseUrl?: string;
}

const { pagination, baseUrl = '/posts' } = Astro.props;
const { currentPage, totalPages, hasNext, hasPrev } = pagination;

function generatePageNumbers(current: number, total: number) {
  const pages: (number | string)[] = [];
  const delta = 2;
  pages.push(1);
  if (current - delta > 2) pages.push('...');
  for (let i = Math.max(2, current - delta); i <= Math.min(total - 1, current + delta); i++) {
    pages.push(i);
  }
  if (current + delta < total - 1) pages.push('...');
  if (total > 1) pages.push(total);
  return pages;
}

const pageNumbers = generatePageNumbers(currentPage, totalPages);

const prevUrl = hasPrev
    ? (currentPage === 2 ? baseUrl : `${baseUrl}/${currentPage - 1}`)
    : undefined;

const nextUrl = hasNext
  ? `${baseUrl}/${currentPage + 1}`
  : undefined;
---

{totalPages > 1 && (
  <nav class="pagination-nav" aria-label="Pagination">
    <div class="pagination-side">
      {hasPrev ? (
        <a href={prevUrl || `${baseUrl}/${currentPage - 1}`} class="pagination-btn">
          <Icon name="arrow-left" class="pagination-icon-left" />
          Previous
        </a>
      ) : (
        <span class="pagination-btn pagination-btn--disabled">
          <Icon name="arrow-left" class="pagination-icon-left" />
          Previous
        </span>
      )}
    </div>

    <div class="pagination-pages">
      {pageNumbers.map(page => (
        typeof page === 'number' ? (
          <a
            href={page === 1 ? baseUrl : `${baseUrl}/${page}`}
            class={`pagination-page ${page === currentPage ? 'pagination-page--active' : ''}`}
            aria-current={page === currentPage ? 'page' : undefined}
          >
            {page}
          </a>
        ) : (
          <span class="pagination-ellipsis">{page}</span>
        )
      ))}
    </div>

    <div class="pagination-mobile-info">
      <span>Page {currentPage} of {totalPages}</span>
    </div>

    <div class="pagination-side pagination-side--right">
      {hasNext ? (
        <a href={nextUrl || `${baseUrl}/${currentPage + 1}`} class="pagination-btn">
          Next
          <Icon name="arrow-right" class="pagination-icon-right" />
        </a>
      ) : (
        <span class="pagination-btn pagination-btn--disabled">
          Next
          <Icon name="arrow-right" class="pagination-icon-right" />
        </span>
      )}
    </div>
  </nav>
)}

<style is:global>
  .pagination-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 0;
    user-select: none;
  }

  .pagination-nav a:focus-visible {
    outline: 2px solid rgb(var(--color-highlight-500));
    outline-offset: 2px;
  }

  .pagination-nav a:hover {
    transform: scale(1.05);
  }

  .pagination-nav [aria-current="page"] {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .pagination-side {
    flex: 1;
    display: flex;
    justify-content: flex-start;
  }

  .pagination-side--right {
    justify-content: flex-end;
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(var(--color-primary-300));
    background-color: rgb(var(--color-primary-900));
    border: 1px solid rgb(var(--color-primary-600));
    border-radius: 0.5rem;
    transition-property: background-color, color, transform;
    transition-duration: 0.2s;
    transition-timing-function: var(--default-easing);
    text-decoration: none;
  }

  .pagination-btn:hover {
    background-color: rgb(var(--color-primary-800));
    color: rgb(var(--color-primary-200));
  }

  .pagination-btn--disabled {
    color: rgb(var(--color-primary-500));
    background-color: rgb(var(--color-primary-800));
    border-color: rgb(var(--color-primary-700));
    cursor: not-allowed;

    &:hover {
      color: rgb(var(--color-primary-500));
    }
  }

  .pagination-icon-left {
    width: 1rem;
    height: 1rem;
    margin-right: 0.5rem;
  }

  .pagination-icon-right {
    width: 1rem;
    height: 1rem;
    margin-left: 0.5rem;
  }

  .pagination-pages {
    display: none;
  }

  @media (min-width: 768px) {
    .pagination-pages {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    border-radius: 0.5rem;
    transition-property: background-color, border-color, color, transform;
    transition-duration: 0.2s;
    transition-timing-function: var(--default-easing);
    color: rgb(var(--color-primary-300));
    background-color: rgb(var(--color-primary-900));
    border: 1px solid rgb(var(--color-primary-600));
    text-decoration: none;
  }

  .pagination-page:not(.pagination-page--active):hover {
    background-color: rgb(var(--color-primary-800));
    color: rgb(var(--color-primary-200));
  }

  .pagination-page--active {
    background-color: rgb(var(--color-highlight-400));
    color: white;
    border-color: rgb(var(--color-highlight-400));
  }

  .pagination-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.875rem;
    color: rgb(var(--color-primary-500));
  }

  .pagination-mobile-info {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    color: rgb(var(--color-primary-300));
  }

  @media (min-width: 768px) {
    .pagination-mobile-info { display: none; }
  }
</style>
