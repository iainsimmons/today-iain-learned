---
import type { startsWith } from 'astro:schema';
import { siteConfig } from '../config';
import Icon from './Icon.astro';
---
<style>
  dialog {
    position: fixed;
    inset: 0;
    margin: auto;
  }
  dialog::backdrop {
    background-color: rgb(0 0 0 / .5);
    backdrop-filter: blur(5px);
  }
</style>

<!-- Make site configuration available to client-side JavaScript -->
<script define:vars={{ siteConfig }}>
  window.siteConfig = siteConfig;
</script>

<!-- Command Palette Dialog -->
<dialog 
  id="command-palette-dialog"
  class="border-glow-top border-glow-top-permanent w-full max-w-2xl bg-white dark:bg-primary-900 rounded-xl shadow-2xl border border-primary-200 dark:border-primary-700 p-0"
>
  <!-- Header -->
  <div class="flex items-center justify-between p-4 border-b border-primary-200 dark:border-primary-700">
    <h2 class="text-lg font-semibold text-primary-900 dark:text-primary-50">
      Command Palette
    </h2>
    <button 
      command="close" 
      commandfor="command-palette-dialog"
      class="p-1 hover:bg-primary-100 dark:hover:bg-primary-800 text-primary-500 dark:text-primary-400 rounded-lg transition-colors cursor-pointer"
      aria-label="Close dialog"
    >
      <Icon name="x" class="w-5 h-5" />
    </button>
  </div>

  <!-- Search Input -->
  <div class="p-4">
    <div class="relative">
      <input
        id="command-palette-input"
        type="text"
        placeholder={siteConfig.commandPalette.placeholder}
        class="w-full pr-10 bg-primary-50 dark:bg-primary-800 border border-primary-200 dark:border-primary-600 rounded-lg text-primary-900 dark:text-primary-50 placeholder-primary-500 dark:placeholder-primary-400 focus:outline-none focus:ring-2 focus:ring-highlight-500 focus:border-transparent"
        autocomplete="off"
        spellcheck="false"
      />
      <div class="absolute right-3 top-1/2 transform -translate-y-1/2">
        <Icon name="search" class="w-4 h-4 text-primary-500 dark:text-primary-400" />
      </div>
    </div>
  </div>

  <!-- Results Container -->
  <div id="command-palette-results" class="max-h-96 overflow-y-auto">
    <!-- Loading indicator -->
    <div id="command-palette-loading" class="hidden p-4 text-center">
      <div class="inline-flex items-center space-x-2">
        <div class="animate-spin rounded-full h-4 w-4 border-2 border-primary-300 dark:border-primary-600 border-t-highlight-500"></div>
        <span class="text-sm text-primary-500 dark:text-primary-400">Searching...</span>
      </div>
    </div>

    <!-- No results message -->
    <div id="command-palette-no-results" class="hidden p-8 text-center">
      <p class="text-sm text-primary-500 dark:text-primary-400">No results found.</p>
    </div>

    <!-- Default view (sections) -->
    <div id="command-palette-default" class="divide-y divide-primary-200 dark:divide-primary-700">

      <!-- Navigation Section -->
      {siteConfig.commandPalette.sections.pages && (
        <div class="p-2">
          <div class="px-3 py-2 text-xs font-medium text-primary-500 dark:text-primary-400 uppercase tracking-wider">
            Navigation
          </div>
          <div class="command-palette-nav-group">
            {siteConfig.navigation.pages.map((page) => (
              <a
                href={page.url}
                class="w-full flex items-center gap-3 px-3 py-2 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-800 rounded-lg text-left transition-colors"
              >
                {page.url?.startsWith('http') ? <Icon name="external-link" class="w-4 h-4" /> : null}
                <span>{page.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Social Links Section -->
      {siteConfig.commandPalette.sections.social && (
        <div class="p-2">
          <div class="px-3 py-2 text-xs font-medium text-primary-500 dark:text-primary-400 uppercase tracking-wider">
            Social
          </div>
          <div class="command-palette-nav-group">
            {siteConfig.navigation.social.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center gap-3 px-3 py-2 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-800 rounded-lg text-left transition-colors"
              >
                <Icon name={link.icon} class="w-4 h-4" />
                <span>{link.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Search results (populated by JS) -->
    <div id="command-palette-search-results" class="hidden divide-y divide-primary-200 dark:divide-primary-700">
    </div>
  </div>

  <!-- Footer -->
  <div class="p-3 border-t border-primary-200 dark:border-primary-700 bg-primary-50 dark:bg-primary-800">
    <div class="flex items-center justify-between text-xs text-primary-500 dark:text-primary-400">
      <span>Use tab/shift+tab to navigate, ↵ to select, ESC to close</span>
    </div>
  </div>
</dialog>

<script>
  // Define the structure for items in the command palette
  interface CommandPaletteItem {
    id: string;
    title: string;
    description?: string;
    url: string;
    type: 'post' | 'page' | 'project' | 'documentation' | 'docs' | 'action';
    score?: number;
    tags?: string[];
  }

  // Command Palette Class Definition
  class CommandPalette {
    private dialog: HTMLDialogElement;
    private input: HTMLInputElement;
    private resultsContainer: HTMLElement;
    private searchResults: HTMLElement;
    private defaultView: HTMLElement;
    private loadingEl: HTMLElement;
    private noResultsEl: HTMLElement;
    private selectedIndex: number = -1;
    private allItems: CommandPaletteItem[] = [];
    private abortController: AbortController | null = null;

    constructor() {
      this.dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement;
      this.input = document.getElementById('command-palette-input') as HTMLInputElement;
      this.resultsContainer = document.getElementById('command-palette-results') as HTMLElement;
      this.searchResults = document.getElementById('command-palette-search-results') as HTMLElement;
      this.defaultView = document.getElementById('command-palette-default') as HTMLElement;
      this.loadingEl = document.getElementById('command-palette-loading') as HTMLElement;
      this.noResultsEl = document.getElementById('command-palette-no-results') as HTMLElement;
    }

    private async fetchItems(): Promise<CommandPaletteItem[]> {
      if (this.allItems.length > 0) return this.allItems;

      try {
        const config = window.siteConfig;
        const items: CommandPaletteItem[] = [];

        // Add posts
        if (config.commandPalette.search.posts) {
          const response = await fetch('/api/posts.json');
          const posts = await response.json();
          items.push(...posts.map((post: any) => ({
            id: `post-${post.id}`,
            title: post.data?.title || post.title || post.id,
            description: post.data?.description || post.description || '',
            url: `/posts/${post.id}`,
            type: 'post' as const,
            tags: post.data?.tags || [],
          })));
        }

        // Add pages
        if (config.commandPalette.search.pages) {
          const response = await fetch('/api/pages.json');
          const pages = await response.json();
          items.push(...pages.map((page: any) => ({
            id: `page-${page.id}`,
            title: page.data?.title || page.title || page.id,
            description: page.data?.description || page.description || '',
            url: page.data?.url || page.url || `/${page.id}`,
            type: 'page' as const,
          })));
        }

        this.allItems = items;
        return items;
      } catch (error) {
        console.error('Error fetching command palette items:', error);
        return [];
      }
    }

    private showLoading() {
      this.defaultView.classList.add('hidden');
      this.searchResults.classList.add('hidden');
      this.noResultsEl.classList.add('hidden');
      this.loadingEl.classList.remove('hidden');
    }

    private showDefault() {
      this.loadingEl.classList.add('hidden');
      this.searchResults.classList.add('hidden');
      this.noResultsEl.classList.add('hidden');
      this.defaultView.classList.remove('hidden');
      this.selectedIndex = -1;
    }

    private showNoResults() {
      this.defaultView.classList.add('hidden');
      this.searchResults.classList.add('hidden');
      this.loadingEl.classList.add('hidden');
      this.noResultsEl.classList.remove('hidden');
    }

    private showResults(items: CommandPaletteItem[]) {
      this.defaultView.classList.add('hidden');
      this.loadingEl.classList.add('hidden');
      this.noResultsEl.classList.add('hidden');
      this.searchResults.classList.remove('hidden');

      this.searchResults.innerHTML = items.map((item, index) => `
        <button
          class="w-full flex items-center gap-3 px-3 py-2 text-left transition-colors command-palette-item ${index === 0 ? 'bg-primary-50 dark:bg-primary-800' : 'text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-800'}"
          data-index="${index}"
          data-url="${item.url}"
        >
          <span>${item.title}</span>
          ${item.description ? `<span class="text-xs text-primary-500">${item.description}</span>` : ''}
        </button>
      `).join('');

      this.selectedIndex = items.length > 0 ? 0 : -1;
    }

    private async handleInput() {
      const query = this.input.value.trim().toLowerCase();
      
      if (query.length === 0) {
        this.showDefault();
        return;
      }

      this.showLoading();

      if (this.abortController) {
        this.abortController.abort();
      }
      this.abortController = new AbortController();

      try {
        const allItems = await this.fetchItems();
        const results = allItems
          .map(item => ({
            ...item,
            score: this.calculateScore(item, query)
          }))
          .filter(item => item.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 10);

        if (results.length === 0) {
          this.showNoResults();
        } else {
          this.showResults(results);
        }
      } catch (error: any) {
        if (error.name !== 'AbortError') {
          console.error('Search error:', error);
        }
      }
    }

    private calculateScore(item: CommandPaletteItem, query: string): number {
      let score = 0;
      const title = item.title.toLowerCase();
      const description = (item.description || '').toLowerCase();
      const tags = (item.tags || []).join(' ').toLowerCase();

      if (title === query) score += 100;
      else if (title.startsWith(query)) score += 50;
      else if (title.includes(query)) score += 25;

      if (description.includes(query)) score += 10;
      if (tags.includes(query)) score += 15;

      return score;
    }

    private handleKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        this.close();
      }
    }

    public open() {
      this.dialog.showModal();
      this.input.focus();
      this.input.value = '';
      this.showDefault();
    }

    public close() {
      this.dialog.close();
    }
  }

  // Initialize the command palette
  const commandPalette = new CommandPalette();

  // Make it globally accessible
  window.initializeCommandPalette = () => {
    // Already initialized
  };

  // Open command palette on keyboard shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (commandPalette.dialog.open) {
        commandPalette.close();
      } else {
        commandPalette.open();
      }
    }
  });
</script>
