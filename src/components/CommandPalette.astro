---
import { siteConfig } from '../config';
import Icon from './Icon.astro';
---

<style>
  dialog {
    position: fixed;
    inset: 0;
    margin: 2rem auto auto;
    width: min(100% - 2rem, 42rem);
  }

  dialog::backdrop {
    background-color: rgb(0 0 0 / .5);
    backdrop-filter: blur(5px);
  }

  /* Dialog container */
  :global(.cp-dialog) {
    background-color: rgb(var(--color-primary-900));
    border-radius: 0.75rem;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
    border: 1px solid rgb(var(--color-primary-700));
    padding: 0;
  }
  :root:not(.dark) :global(.cp-dialog) {
    background-color: rgb(255, 255, 255);
    border-color: rgb(var(--color-primary-200));
  }

  /* Header */
  :global(.cp-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-bottom: 1px solid rgb(var(--color-primary-700));
  }
  :root:not(.dark) :global(.cp-header) {
    border-color: rgb(var(--color-primary-200));
  }

  /* Title */
  :global(.cp-title) {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: rgb(var(--color-primary-50));
  }
  :root:not(.dark) :global(.cp-title) {
    color: rgb(var(--color-primary-900));
  }

  /* Close button */
  :global(.cp-close-btn) {
    padding: 0.25rem;
    color: rgb(var(--color-primary-400));
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  :global(.cp-close-btn:hover) {
    background-color: rgb(var(--color-primary-800));
  }
  :root:not(.dark) :global(.cp-close-btn) {
    color: rgb(var(--color-primary-500));
  }
  :root:not(.dark) :global(.cp-close-btn:hover) {
    background-color: rgb(var(--color-primary-100));
  }

  /* Icon sizes */
  :global(.cp-icon-md) { width: 1.25rem; height: 1.25rem; }
  :global(.cp-icon-sm) { width: 1rem; height: 1rem; }
  :global(.cp-icon-xs) { width: 0.75rem; height: 0.75rem; }
  :global(.cp-icon-lg) { width: 2rem; height: 2rem; }

  /* Search wrapper */
  :global(.cp-search-wrapper) { padding: 1rem; }

  /* Search container */
  :global(.cp-search-container) { position: relative; }

  /* Search input */
  :global(.cp-search-input) {
    width: 100%;
    padding-right: 2.5rem;
    background-color: rgb(var(--color-primary-800));
    border: 1px solid rgb(var(--color-primary-600));
    border-radius: 0.5rem;
    color: rgb(var(--color-primary-50));
    outline: none;
  }
  :global(.cp-search-input::placeholder) {
    color: rgb(var(--color-primary-400));
  }
  :global(.cp-search-input:focus) {
    outline: 2px solid rgb(var(--color-highlight-500));
    outline-offset: -2px;
    border-color: transparent;
  }
  :root:not(.dark) :global(.cp-search-input) {
    background-color: rgb(var(--color-primary-50));
    border-color: rgb(var(--color-primary-200));
    color: rgb(var(--color-primary-900));
  }
  :root:not(.dark) :global(.cp-search-input::placeholder) {
    color: rgb(var(--color-primary-500));
  }

  /* Search icon wrapper */
  :global(.cp-search-icon-wrapper) {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Search icon */
  :global(.cp-search-icon) {
    width: 1rem;
    height: 1rem;
    color: rgb(var(--color-primary-400));
  }
  :root:not(.dark) :global(.cp-search-icon) {
    color: rgb(var(--color-primary-500));
  }

  /* Inline loading */
  :global(.cp-inline-loading) {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Spinner */
  :global(.cp-spinner) {
    animation: cp-spin 1s linear infinite;
    border-radius: 9999px;
    height: 1rem;
    width: 1rem;
    border: 2px solid rgb(var(--color-primary-600));
    border-top-color: rgb(var(--color-highlight-500));
  }
  :root:not(.dark) :global(.cp-spinner) {
    border-color: rgb(var(--color-primary-300));
  }

  @keyframes cp-spin {
    to { transform: rotate(360deg); }
  }

  /* Results container */
  :global(.cp-results-container) {
    max-height: 24rem;
    overflow-y: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  :global(.cp-results-container::-webkit-scrollbar) {
    display: none;
  }

  /* Loading state */
  :global(.cp-loading) { padding: 1rem; text-align: center; }

  :global(.cp-loading-content) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: rgb(var(--color-primary-400));
  }
  :root:not(.dark) :global(.cp-loading-content) {
    color: rgb(var(--color-primary-500));
  }

  /* No results */
  :global(.cp-no-results) { padding: 2rem; text-align: center; }

  :global(.cp-no-results-icon) {
    width: 2rem;
    height: 2rem;
    color: rgb(var(--color-primary-500));
    margin: 0 auto 0.5rem;
  }
  :root:not(.dark) :global(.cp-no-results-icon) {
    color: rgb(var(--color-primary-400));
  }

  :global(.cp-no-results-title) {
    color: rgb(var(--color-primary-300));
  }
  :root:not(.dark) :global(.cp-no-results-title) {
    color: rgb(var(--color-primary-600));
  }

  :global(.cp-no-results-subtitle) {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgb(var(--color-primary-400));
    margin-top: 0.25rem;
  }
  :root:not(.dark) :global(.cp-no-results-subtitle) {
    color: rgb(var(--color-primary-500));
  }

  /* Default section */
  :global(.cp-default-section) > * + * {
    border-top-width: 1px;
    border-color: rgb(var(--color-primary-700));
  }
  :root:not(.dark) :global(.cp-default-section) > * + * {
    border-color: rgb(var(--color-primary-200));
  }

  /* Section padding */
  :global(.cp-section) { padding: 0.5rem; }

  /* Section title */
  :global(.cp-section-title) {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    color: rgb(var(--color-primary-400));
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }
  :root:not(.dark) :global(.cp-section-title) {
    color: rgb(var(--color-primary-500));
  }

  /* Result item (default items) */
  :global(.cp-result-item) {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    transition: background-color 0.2s;
  }
  :global(.cp-result-item:hover) {
    background-color: rgb(var(--color-primary-800));
  }
  :root:not(.dark) :global(.cp-result-item:hover) {
    background-color: rgb(var(--color-primary-50));
  }

  :global(.cp-result-item-icon) {
    width: 1rem;
    height: 1rem;
    color: rgb(var(--color-primary-400));
    transition: color 0.2s;
  }
  :global(.cp-result-item:hover) :global(.cp-result-item-icon) {
    color: rgb(var(--color-highlight-500));
  }
  :root:not(.dark) :global(.cp-result-item-icon) {
    color: rgb(var(--color-primary-500));
  }

  :global(.cp-result-item-title) {
    color: rgb(var(--color-primary-50));
  }
  :root:not(.dark) :global(.cp-result-item-title) {
    color: rgb(var(--color-primary-900));
  }

  :global(.cp-result-item-ext) {
    width: 0.75rem;
    height: 0.75rem;
    color: rgb(var(--color-primary-500));
  }
  :root:not(.dark) :global(.cp-result-item-ext) {
    color: rgb(var(--color-primary-400));
  }

  /* Search results */
  :global(.cp-search-results) { transition: opacity 200ms var(--default-easing); }
  :global(.cp-search-results) > * + * {
    border-top-width: 1px;
    border-color: rgb(var(--color-primary-700));
  }
  :root:not(.dark) :global(.cp-search-results) > * + * {
    border-color: rgb(var(--color-primary-200));
  }

  /* Footer */
  :global(.cp-footer) {
    padding: 0.75rem;
    border-top: 1px solid rgb(var(--color-primary-700));
    background-color: rgb(var(--color-primary-800));
    border-radius: 0 0 0.75rem 0.75rem;
  }
  :root:not(.dark) :global(.cp-footer) {
    border-color: rgb(var(--color-primary-200));
    background-color: rgb(var(--color-primary-50));
  }

  :global(.cp-footer-text) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    line-height: 1rem;
    color: rgb(var(--color-primary-400));
  }
  :root:not(.dark) :global(.cp-footer-text) {
    color: rgb(var(--color-primary-500));
  }

  /* Search result items (created by JS) */
  :global(.command-palette-item),
  :global(.cp-result-item-search) {
    width: 100%;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    transition: background-color 0.2s;
  }
  :global(.command-palette-item:hover),
  :global(.cp-result-item-search:hover) {
    background-color: rgb(var(--color-primary-800));
  }
  :root:not(.dark) :global(.command-palette-item:hover),
  :root:not(.dark) :global(.cp-result-item-search:hover) {
    background-color: rgb(var(--color-primary-50));
  }

  :global(.cp-selected) {
    background-color: rgb(var(--color-primary-800));
  }
  :root:not(.dark) :global(.cp-selected) {
    background-color: rgb(var(--color-primary-50));
  }

  :global(.cp-result-item-search-icon) {
    width: 1rem;
    height: 1rem;
    color: rgb(var(--color-primary-400));
    margin-top: 0.125rem;
    transition: color 0.2s;
  }
  :global(.command-palette-item:hover) :global(.cp-result-item-search-icon),
  :global(.cp-result-item-search:hover) :global(.cp-result-item-search-icon) {
    color: rgb(var(--color-highlight-500));
  }
  :root:not(.dark) :global(.cp-result-item-search-icon) {
    color: rgb(var(--color-primary-500));
  }

  :global(.cp-result-item-search-content) {
    flex: 1 1 0%;
    min-width: 0;
  }

  :global(.cp-result-item-search-title) {
    color: rgb(var(--color-primary-50));
    font-weight: 500;
  }
  :root:not(.dark) :global(.cp-result-item-search-title) {
    color: rgb(var(--color-primary-900));
  }

  :global(.cp-result-item-search-desc) {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgb(var(--color-primary-300));
    margin-top: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :root:not(.dark) :global(.cp-result-item-search-desc) {
    color: rgb(var(--color-primary-600));
  }

  /* Mark highlighting */
  :global(.cmd-mark) {
    background-color: rgb(var(--color-highlight-800));
    color: rgb(var(--color-highlight-100));
    padding-left: 0.25rem;
    padding-right: 0.25rem;
    border-radius: 0.25rem;
  }
  :root:not(.dark) :global(.cmd-mark) {
    background-color: rgb(var(--color-highlight-200));
    color: rgb(var(--color-highlight-900));
  }

  /* Virtual scroll container */
  :global(.cp-scroll-container) { overflow-y: auto; }

  /* Hidden utility */
  :global(.cp-hidden) { display: none; }
</style>

<!-- Make site configuration available to client-side JavaScript -->
<script define:vars={{ siteConfig }}>
  window.siteConfig = siteConfig;
</script>

<!-- Command Palette Dialog -->
<dialog 
  id="command-palette-dialog"
  class="border-glow-top cp-dialog"
>
  <div>
      <!-- Header -->
      <div class="cp-header">
        <h2 id="command-palette-title" class="cp-title">
          Command Palette
        </h2>
        <button 
          id="command-palette-close"
          command="close" 
          commandfor="command-palette-dialog"
          class="cp-close-btn"
          aria-label="Close dialog"
        >
          <Icon name="x" class="cp-icon-md" />
        </button>
      </div>

      <!-- Search Input -->
      <div class="cp-search-wrapper">
        <div class="cp-search-container">
          <input
            id="command-palette-input"
            type="text"
            placeholder={siteConfig.commandPalette.placeholder}
            class="cp-search-input"
            autocomplete="off"
            spellcheck="false"
          >
          <!-- Search icon -->
          <div class="cp-search-icon-wrapper">
            <Icon name="search" class="cp-search-icon" />
          </div>
          <!-- Inline loading indicator -->
          <div id="command-palette-inline-loading" class="cp-inline-loading cp-hidden">
            <div class="cp-spinner"></div>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div id="command-palette-results" class="cp-results-container">
        <!-- Loading state -->
        <div id="command-palette-loading" class="cp-loading cp-hidden">
          <div class="cp-loading-content">
            <span>Searching...</span>
            <div class="cp-spinner"></div>
          </div>
        </div>

        <!-- No results -->
        <div id="command-palette-no-results" class="cp-no-results cp-hidden">
          <Icon name="search-x" class="cp-no-results-icon" />
          <p class="cp-no-results-title">No results found</p>
          <p class="cp-no-results-subtitle">Try a different search term</p>
        </div>

        <!-- Default items (shown when no search) -->
        <div id="command-palette-default" class="cp-default-section">

          <!-- Pages -->
          {siteConfig.commandPalette.sections.pages && siteConfig.navigation.pages.length > 0 && (
            <div class="cp-section">
              <div class="cp-section-title">
                Pages
              </div>
              {siteConfig.navigation.pages.map(page => (
                <a 
                  href={page.url || '#'}
                  class="cp-result-item"
                  target={page.url?.startsWith('http') ? '_blank' : undefined}
                >
                  <Icon name="file-text" class="cp-result-item-icon" />
                  <span class="cp-result-item-title">{page.title}</span>
                  {page.url?.startsWith('http') && (
                    <Icon name="external-link" class="cp-result-item-ext" />
                  )}
                </a>
              ))}
            </div>
          )}

          <!-- Social Links -->
          {siteConfig.commandPalette.sections.social && (siteConfig.navigation.social || []).filter((social) => social && social.url && social.icon).length > 0 && (
            <div class="cp-section">
              <div class="cp-section-title">
                Social
              </div>
              {(siteConfig.navigation.social || []).filter((social) => social && social.url && social.icon).map(social => (
                <a 
                  href={social.url}
                  target="_blank"
                  class="cp-result-item"
                >
                  <Icon name={social.icon} class="cp-result-item-icon" />
                  <span class="cp-result-item-title">{social.title}</span>
                  <Icon name="external-link" class="cp-result-item-ext" />
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Search results will be populated here -->
        <div id="command-palette-search-results" class="cp-search-results cp-hidden">
        </div>

      </div>

      <!-- Footer -->
      <div class="cp-footer">
        <div class="cp-footer-text">
          <span>Use ↑↓ to navigate, ↵ to select, ESC to close</span>
        </div>
      </div>
    </div>
  </dialog>

<script>
  interface CommandPaletteItem {
    id: string;
    title: string;
    description?: string;
    url: string;
    type: 'post' | 'page' | 'project' | 'documentation' | 'docs' | 'action';
    score?: number;
    tags?: string[];
  }

  class CommandPalette {
    private dialog: HTMLDialogElement;
    private input: HTMLInputElement;
    private results: HTMLElement;
    private loading: HTMLElement;
    private inlineLoading: HTMLElement;
    private noResults: HTMLElement;
    private defaultItems: HTMLElement;
    private searchResults: HTMLElement;
    private themeList: HTMLElement;
    private isOpen: boolean = false;
    private selectedIndex: number = -1;
    private items: CommandPaletteItem[] = [];
    private filteredItems: CommandPaletteItem[] = [];
    private searchTimeout: number | null = null;
    private cache: Map<string, CommandPaletteItem[]> = new Map();
    private fuse: any = null;
    private searchHistory: string[] = [];
    private readonly MAX_RESULTS = 50;
    private readonly SEARCH_DEBOUNCE_MS = 100;
    private readonly MAX_CACHE_SIZE = 100;
    private readonly VIRTUAL_SCROLL_THRESHOLD = 100;

    constructor() {
      this.dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement;
      this.input = document.getElementById('command-palette-input') as HTMLInputElement;
      this.results = document.getElementById('command-palette-results')!;
      this.loading = document.getElementById('command-palette-loading')!;
      this.inlineLoading = document.getElementById('command-palette-inline-loading')!;
      this.noResults = document.getElementById('command-palette-no-results')!;
      this.defaultItems = document.getElementById('command-palette-default')!;
      this.searchResults = document.getElementById('command-palette-search-results')!;
      this.themeList = document.getElementById('theme-list')!;

      this.init();
      this.loadSearchHistory();
      this.preloadData();
    }

    private init() {
      window.addEventListener('openCommandPalette', () => this.open());

      this.dialog.addEventListener('click', (e) => {
        if (e.target === this.dialog) {
          this.close();
        }
      });

      this.input.addEventListener('input', (e) => this.handleSearch((e.target as HTMLInputElement).value));
      this.input.addEventListener('keydown', (e) => this.handleKeyDown(e));

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const commandPaletteLink = target.closest('#command-palette-dialog a[href]');
        if (commandPaletteLink && this.isOpen) {
          e.preventDefault();
          const href = commandPaletteLink.getAttribute('href');
          if (href) {
            this.close();
            setTimeout(() => {
              if (href.startsWith('http') && !href.includes(window.location.hostname)) {
                window.open(href, '_blank');
              } else {
                window.location.href = href;
              }
            }, 50);
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if (this.isOpen && e.key === 'Escape') {
          this.close();
        }
      });
    }

    private async preloadData() {
      this.loadPosts();
    }

    private async loadPosts() {
      if (this.items.length > 0) {
        return;
      }

      try {
        const searchConfig = (window as any).siteConfig?.commandPalette?.search || {
          posts: true,
          pages: false
        };

        const allItems = [];
        const promises = [];

        if (searchConfig.posts) {
          promises.push(
            fetch('/api/posts.json').then(response => 
              response.ok ? response.json() : []
            )
          );
        } else {
          promises.push(Promise.resolve([]));
        }

        if (searchConfig.pages) {
          promises.push(
            fetch('/api/pages.json').then(response => {
              return response.ok ? response.json() : [];
            }).catch(error => {
              return [];
            })
          );
        } else {
          promises.push(Promise.resolve([]));
        }

        const [posts, pages] = await Promise.all(promises);

        allItems.push(...posts, ...pages);

        this.items = allItems;
      } catch (error) {
        this.items = [];
      }
    }

    private async initializeFuseSearch() {
      try {
        await new Promise(resolve => setTimeout(resolve, 100));
        
        const fuseModule = await import('fuse.js');
        const Fuse = fuseModule.default || fuseModule;
        
        if (typeof Fuse === 'function') {
          this.fuse = new Fuse(this.items, {
            keys: [
              { name: 'title', weight: 0.5 },
              { name: 'description', weight: 0.2 },
              { name: 'tags', weight: 0.3 }
            ],
            threshold: 0.3,
            includeScore: true,
            includeMatches: true,
            minMatchCharLength: 1,
            shouldSort: true,
            findAllMatches: true,
            ignoreLocation: true,
            useExtendedSearch: true
          });
        } else {
          throw new Error('Fuse.js not properly loaded');
        }
      } catch (error) {
        this.fuse = null;
      }
    }

    private async searchItems(query: string): Promise<CommandPaletteItem[]> {
      if (!query.trim()) return [];

      if (!this.fuse && this.items.length > 0) {
        await this.initializeFuseSearch();
      }

      if (this.fuse) {
        return this.fuzzySearch(query);
      } else {
        return this.basicSearch(query);
      }
    }

    private fuzzySearch(query: string): CommandPaletteItem[] {
      const results = this.fuse.search(query);
      return results
        .slice(0, this.MAX_RESULTS)
        .map((result: any) => ({
          ...result.item,
          score: result.score ? (1 - result.score) * 1000 : 0,
          matches: result.matches
        }));
    }

    private basicSearch(query: string): CommandPaletteItem[] {
      const queryLower = query.toLowerCase();
      const queryWords = queryLower.split(/\s+/).filter(word => word.length > 0);

      return this.items
        .map(item => {
          const title = item.title.toLowerCase();
          const description = (item.description || '').toLowerCase();
          const tags = (item.tags || []).join(' ').toLowerCase();

          let score = 0;

          if (title === queryLower) {
            score += 1000;
          } else if (title.startsWith(queryLower)) {
            score += 500;
          } else if (title.includes(queryLower)) {
            score += 200;
          }

          if (description.includes(queryLower)) {
            score += 100;
          }

          if (tags.includes(queryLower)) {
            score += 300;
          }

          queryWords.forEach(word => {
            if (title.includes(word)) {
              score += 50;
            }
            if (description.includes(word)) {
              score += 25;
            }
            if (tags.includes(word)) {
              score += 40;
            }
          });

          const wordBoundaryRegex = new RegExp(`\\b${queryLower}`, 'i');
          if (wordBoundaryRegex.test(title)) {
            score += 100;
          }
          if (wordBoundaryRegex.test(description)) {
            score += 50;
          }
          if (wordBoundaryRegex.test(tags)) {
            score += 80;
          }

          return { ...item, score };
        })
        .filter(item => item.score > 0)
        .sort((a, b) => (b.score || 0) - (a.score || 0))
        .slice(0, this.MAX_RESULTS);
    }

    private applyPreservedSelection() {
      if (this.selectedIndex >= 0 && this.isOpen) {
        const searchResultsVisible = !this.searchResults.classList.contains('cp-hidden');
        const defaultItemsVisible = !this.defaultItems.classList.contains('cp-hidden');
        
        let items: NodeListOf<Element>;
        
        if (searchResultsVisible) {
          items = this.searchResults.querySelectorAll('.command-palette-item');
        } else if (defaultItemsVisible) {
          items = this.defaultItems.querySelectorAll('a, button[data-action]');
        } else {
          return;
        }

        if (this.selectedIndex < items.length) {
          this.updateSelection(items);
        } else {
          this.selectedIndex = -1;
        }
      }
    }

    private open() {
      this.isOpen = true;
      this.dialog.showModal();
      this.input.focus();
      this.input.value = '';
      this.showDefault();
      document.body.style.overflow = 'hidden';
    }

    private close() {
      this.isOpen = false;
      this.dialog.close();
      this.input.blur();
      this.input.value = '';
      if (document.body.style.overflow) {
        document.body.style.overflow = '';
      }
    }

    private showDefault() {
      this.loading.classList.add('cp-hidden');
      this.inlineLoading.classList.add('cp-hidden');
      this.noResults.classList.add('cp-hidden');
      this.searchResults.classList.add('cp-hidden');
      this.defaultItems.classList.remove('cp-hidden');
    }

    private showLoading() {
      this.defaultItems.classList.add('cp-hidden');
      this.noResults.classList.add('cp-hidden');
      this.searchResults.classList.add('cp-hidden');
      this.loading.classList.add('cp-hidden');
      this.inlineLoading.classList.remove('cp-hidden');
    }

    private showNoResults() {
      this.defaultItems.classList.add('cp-hidden');
      this.loading.classList.add('cp-hidden');
      this.inlineLoading.classList.add('cp-hidden');
      this.searchResults.classList.add('cp-hidden');
      this.noResults.classList.remove('cp-hidden');
    }

    private showSearchResults() {
      this.defaultItems.classList.add('cp-hidden');
      this.loading.classList.add('cp-hidden');
      this.inlineLoading.classList.add('cp-hidden');
      this.noResults.classList.add('cp-hidden');
      this.searchResults.classList.remove('cp-hidden');
    }

    private showThemeSelection() {
      this.defaultItems.classList.add('cp-hidden');
      this.loading.classList.add('cp-hidden');
      this.inlineLoading.classList.add('cp-hidden');
      this.noResults.classList.add('cp-hidden');
      this.searchResults.classList.add('cp-hidden');
    }

    private showInlineLoading() {
      this.inlineLoading.classList.remove('cp-hidden');
    }

    private handleSearch(query: string) {
      if (this.searchTimeout) {
        clearTimeout(this.searchTimeout);
      }

      if (!query.trim()) {
        this.showDefault();
        setTimeout(() => {
          this.applyPreservedSelection();
        }, 10);
        return;
      }

      this.selectedIndex = -1;

      this.showInlineLoading();

      this.searchTimeout = window.setTimeout(() => {
        this.performSearch(query);
      }, this.SEARCH_DEBOUNCE_MS);
    }

    private async performSearch(query: string) {
      const trimmedQuery = query.trim();
      if (!trimmedQuery) {
        this.showDefault();
        return;
      }

      this.updateSearchHistory(trimmedQuery);

      const cacheKey = trimmedQuery.toLowerCase();
      if (this.cache.has(cacheKey)) {
        this.filteredItems = this.cache.get(cacheKey)!;
        this.displaySearchResults();
        return;
      }

      await this.loadPosts();

      this.filteredItems = await this.searchItems(trimmedQuery);

      this.manageCache(cacheKey, [...this.filteredItems]);

      this.inlineLoading.classList.add('cp-hidden');
      this.displaySearchResults();
    }

    private updateSearchHistory(query: string) {
      const index = this.searchHistory.indexOf(query);
      if (index > -1) {
        this.searchHistory.splice(index, 1);
      }
      
      this.searchHistory.unshift(query);
      
      this.searchHistory = this.searchHistory.slice(0, 20);
      
      try {
        localStorage.setItem('command-palette-history', JSON.stringify(this.searchHistory));
      } catch (e) {
      }
    }

    private loadSearchHistory() {
      try {
        const stored = localStorage.getItem('command-palette-history');
        if (stored) {
          this.searchHistory = JSON.parse(stored);
        }
      } catch (e) {
      }
    }

    private manageCache(key: string, results: CommandPaletteItem[]) {
      if (this.cache.size >= this.MAX_CACHE_SIZE) {
        const firstKey = this.cache.keys().next().value;
        if (firstKey) {
          this.cache.delete(firstKey);
        }
      }
      
      this.cache.set(key, results);
    }

    private displaySearchResults() {
      if (this.filteredItems.length === 0) {
        this.showNoResults();
      } else {
        this.searchResults.style.opacity = '0.7';
        
        requestAnimationFrame(() => {
          this.renderSearchResults();
          this.showSearchResults();
          
          requestAnimationFrame(() => {
            this.searchResults.style.opacity = '1';
          });
        });
      }
    }

    private renderSearchResults() {
      this.searchResults.innerHTML = '';

      const searchConfig = (window as any).siteConfig?.commandPalette?.search || {
        posts: true,
        pages: false
      };

      const enabledTypes: string[] = [];
      if (searchConfig.posts) enabledTypes.push('post');
      if (searchConfig.pages) enabledTypes.push('page');

      const filteredByType = this.filteredItems.filter((item: CommandPaletteItem) => enabledTypes.includes(item.type));

      if (filteredByType.length === 0) {
        return;
      }

      const groupedItems = {
        posts: filteredByType.filter(item => item.type === 'post'),
        pages: filteredByType.filter(item => item.type === 'page'),
      };

      Object.entries(groupedItems).forEach(([type, items]) => {
        if (items.length > 0) {
          const container = document.createElement('div');
          container.className = 'cp-section';

          const header = document.createElement('div');
          header.className = 'cp-section-title';
          
          const sectionTitles: Record<string, string> = {
            posts: 'Posts',
            pages: 'Pages',
          };
          
          header.textContent = `${sectionTitles[type as keyof typeof sectionTitles]} (${items.length})`;
          container.appendChild(header);

          if (items.length > this.VIRTUAL_SCROLL_THRESHOLD) {
            this.renderVirtualizedResults(container, items);
          } else {
            this.renderStandardResults(container, items);
          }

          this.searchResults.appendChild(container);
        }
      });
    }

    private renderStandardResults(container: HTMLElement, items: CommandPaletteItem[]) {
      const fragment = document.createDocumentFragment();

      items.forEach((item, index) => {
        const anchor = this.createResultItem(item, index);
        fragment.appendChild(anchor);
      });

      container.appendChild(fragment);
    }

    private renderVirtualizedResults(container: HTMLElement, items: CommandPaletteItem[]) {
      const ITEM_HEIGHT = 60;
      const VISIBLE_ITEMS = 10;
      const SCROLL_CONTAINER_HEIGHT = ITEM_HEIGHT * VISIBLE_ITEMS;

      const scrollContainer = document.createElement('div');
      scrollContainer.className = 'cp-scroll-container';
      scrollContainer.style.height = `${SCROLL_CONTAINER_HEIGHT}px`;

      const virtualContent = document.createElement('div');
      virtualContent.style.height = `${items.length * ITEM_HEIGHT}px`;
      virtualContent.style.position = 'relative';

      const viewport = document.createElement('div');
      viewport.style.position = 'absolute';
      viewport.style.top = '0';
      viewport.style.left = '0';
      viewport.style.right = '0';

      this.renderVisibleItems(viewport, items, 0, VISIBLE_ITEMS);

      let scrollTimeout: number;
      scrollContainer.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = window.setTimeout(() => {
          const scrollTop = scrollContainer.scrollTop;
          const startIndex = Math.floor(scrollTop / ITEM_HEIGHT);
          const endIndex = Math.min(startIndex + VISIBLE_ITEMS, items.length);
          
          viewport.innerHTML = '';
          this.renderVisibleItems(viewport, items, startIndex, endIndex);
          
          viewport.style.transform = `translateY(${startIndex * ITEM_HEIGHT}px)`;
        }, 16);
      });

      virtualContent.appendChild(viewport);
      scrollContainer.appendChild(virtualContent);
      container.appendChild(scrollContainer);
    }

    private renderVisibleItems(container: HTMLElement, items: CommandPaletteItem[], startIndex: number, endIndex: number) {
      const fragment = document.createDocumentFragment();
      
      for (let i = startIndex; i < endIndex; i++) {
        const item = items[i];
        const anchor = this.createResultItem(item, i);
        fragment.appendChild(anchor);
      }
      
      container.appendChild(fragment);
    }

    private createResultItem(item: CommandPaletteItem, index: number): HTMLElement {
      const anchor = document.createElement('a');
      anchor.href = item.url;
      anchor.dataset.index = index.toString();
      anchor.className = `command-palette-item cp-result-item-search ${index === this.selectedIndex ? 'cp-selected' : ''}`;
      
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        this.close();
        
        setTimeout(() => {
          if (item.url.startsWith('http') && !item.url.includes(window.location.hostname)) {
            window.open(item.url, '_blank');
          } else {
            window.location.href = item.url;
          }
        }, 50);
      });
      
      const iconDiv = document.createElement('div');
      iconDiv.className = 'cp-result-item-search-icon';
      
      let iconPath = '';
      switch (item.type) {
        case 'post':
          iconPath = '<path d="M16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8Z"/><path d="M15 3v4a2 2 0 0 0 2 2h4"/>';
          break;
        case 'project':
          iconPath = '<path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"/>';
          break;
        case 'docs':
        case 'documentation':
          iconPath = '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="M8 11h8"/><path d="M8 7h6"/>';
          break;
        case 'page':
          iconPath = '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>';
          break;
        default:
          iconPath = '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>';
      }
      
      iconDiv.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${iconPath}</svg>`;
      anchor.appendChild(iconDiv);

      const contentDiv = document.createElement('div');
      contentDiv.className = 'cp-result-item-search-content';

      const titleSpan = document.createElement('div');
      titleSpan.className = 'cp-result-item-search-title';
      titleSpan.innerHTML = this.highlightSearchTerm(item.title, this.input.value);
      contentDiv.appendChild(titleSpan);

      if (item.description) {
        const descriptionPara = document.createElement('div');
        descriptionPara.className = 'cp-result-item-search-desc';
        descriptionPara.innerHTML = this.highlightSearchTerm(item.description, this.input.value);
        contentDiv.appendChild(descriptionPara);
      }

      anchor.appendChild(contentDiv);
      return anchor;
    }

    private highlightSearchTerm(text: string, searchTerm: string): string {
      if (!searchTerm.trim()) return text;
      
      const regex = new RegExp(`(${searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<mark class="cmd-mark">$1</mark>');
    }

    private handleKeyDown(e: KeyboardEvent) {
      const searchResultsVisible = !this.searchResults.classList.contains('cp-hidden');
      const defaultItemsVisible = !this.defaultItems.classList.contains('cp-hidden');
      
      let items: NodeListOf<Element>;
      
      if (searchResultsVisible) {
        items = this.searchResults.querySelectorAll('.command-palette-item');
      } else if (defaultItemsVisible) {
        items = this.defaultItems.querySelectorAll('a, button[data-action]');
      } else {
        return;
      }

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          this.selectedIndex = Math.min(this.selectedIndex + 1, items.length - 1);
          this.updateSelection(items);
          break;
        case 'ArrowUp':
          e.preventDefault();
          this.selectedIndex = Math.max(this.selectedIndex - 1, -1);
          this.updateSelection(items);
          break;
        case 'Enter':
          e.preventDefault();
          this.selectItem(items);
          break;
        case 'Escape':
          this.close();
          break;
      }
    }

    private updateSelection(items: NodeListOf<Element>) {
      items.forEach((item, index) => {
        if (index === this.selectedIndex) {
          item.classList.add('cp-selected');
          this.scrollIntoView(item);
        } else {
          item.classList.remove('cp-selected');
        }
      });
    }

    private scrollIntoView(element: Element) {
      const scrollContainer = this.results;
      
      if (!scrollContainer) return;

      const containerRect = scrollContainer.getBoundingClientRect();
      const elementRect = element.getBoundingClientRect();
      
      if (elementRect.top < containerRect.top) {
        element.scrollIntoView({ 
          behavior: 'smooth', 
          block: 'nearest',
          inline: 'nearest'
        });
      }
      else if (elementRect.bottom > containerRect.bottom) {
        element.scrollIntoView({ 
          behavior: 'smooth', 
          block: 'nearest',
          inline: 'nearest'
        });
      }
    }

    private selectItem(items: NodeListOf<Element>) {
      if (this.selectedIndex < 0 && items.length > 0) {
        this.selectedIndex = 0;
      }
      
      if (this.selectedIndex >= 0 && items[this.selectedIndex]) {
        const item = items[this.selectedIndex] as HTMLElement;
        
        setTimeout(() => {
          if (item.tagName === 'A') {
            const anchor = item as HTMLAnchorElement;
            const isExternal = anchor.href.startsWith('http') && !anchor.href.includes(window.location.hostname);
            
            if (isExternal) {
              window.open(anchor.href, '_blank');
            } else {
              window.location.href = anchor.href;
            }
          }
        }, 50);
      }
    }
  }

  function initCommandPalette() {
    if (document.getElementById('command-palette-dialog')) {
      const instance = new CommandPalette();
      (window as any).commandPaletteInstance = instance;
    }
  }

  document.addEventListener('DOMContentLoaded', initCommandPalette);
</script>
