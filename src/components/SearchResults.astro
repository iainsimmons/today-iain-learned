---
import Icon from './Icon.astro';

export interface Props {
  results: Array<{
    id: string;
    title: string;
    description?: string;
    url: string;
    type: 'post' | 'page' | 'external';
  }>;
}

const { results } = Astro.props;
---

{results.length > 0 ? (
  <div style="border-top: 1px solid rgb(var(--color-primary-700));">
    <div style="padding: 0.5rem;">
      <div class="result-section-title">
        Results ({results.length})
      </div>
      {results.map((result, index) => (
        <a 
          href={result.url}
          data-index={index}
          class="result-item"
        >
          <Icon 
            name={result.type === 'post' ? 'file-text' : result.type === 'page' ? 'file' : 'external-link'} 
            class="result-item-icon"
          />
          <div class="result-item-content">
            <div class="result-item-title">
              {result.title}
            </div>
            {result.description && (
              <div class="result-item-desc">
                {result.description}
              </div>
            )}
          </div>
          {result.type === 'external' && (
            <Icon name="external-link" class="result-ext-icon" />
          )}
        </a>
      ))}
    </div>
  </div>
) : (
  <div class="empty-state empty-state--compact">
    <Icon name="search-x" class="empty-state-icon" />
    <p class="empty-state-title" style="font-size: 1rem; margin-bottom: 0;">No results found</p>
    <p class="result-item-desc" style="margin-top: 0.25rem;">Try a different search term</p>
  </div>
)}


