---
import { siteConfig } from '@/config';
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const socialLinks = (siteConfig.navigation.social || []).filter((social) => social && social.url && social.icon);
const showSocialIcons = siteConfig.footer.showSocialIconsInFooter && socialLinks.length > 0;
const showProfilePicture = siteConfig.profilePicture.enabled && siteConfig.profilePicture.placement === 'footer';
const profilePicture = siteConfig.profilePicture;
const footerEnabled = siteConfig.footer.enabled;

const footerContent = siteConfig.footer.content.replace('{year}', `${new Date().getFullYear()}`).replace('{author}', siteConfig.author);

const getProfilePictureClasses = (size: string, style: string) => {
  let classes = 'footer-profile-img';
  switch (size) {
    case 'sm': classes += ' footer-profile-img--sm'; break;
    case 'lg': classes += ' footer-profile-img--lg'; break;
    default: classes += ' footer-profile-img--md';
  }
  switch (style) {
    case 'circle': classes += ' footer-profile-img--circle'; break;
    case 'square': classes += ' footer-profile-img--square'; break;
    default: classes += ' footer-profile-img--none';
  }
  return classes;
};
---

<footer class="site-footer">
  <div class="container-inner" style={`max-width: ${siteConfig.layout.contentWidth}`}>
    {showProfilePicture && footerEnabled && (
      <div class="footer-profile-row">
        {profilePicture.url ? (
          <a href={profilePicture.url} class="footer-profile-link" target={profilePicture.url.startsWith('http') ? '_blank' : undefined} rel={profilePicture.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <img src={profilePicture.image} alt={profilePicture.alt} class={getProfilePictureClasses(profilePicture.size, profilePicture.style)} />
          </a>
        ) : (
          <img src={profilePicture.image} alt={profilePicture.alt} class={getProfilePictureClasses(profilePicture.size, profilePicture.style)} />
        )}
      </div>
    )}

    {showSocialIcons && (
      <div class="footer-social-mobile">
        <div class="footer-social-row">
          {socialLinks.map((social) => (
            <a href={social.url} title={social.title} class="footer-social-link" target="_blank">
              <Icon name={social.icon} class="footer-social-icon" />
              <span class="sr-only">{social.title}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {footerEnabled && (
      <div class={`footer-content-row ${showSocialIcons ? 'footer-content-row--with-social' : ''}`}>
        <p class="footer-content-text" set:html={footerContent} />
        {showSocialIcons && (
          <div class="footer-social-desktop">
            {socialLinks.map((social) => (
              <a href={social.url} title={social.title} class="footer-social-link" target="_blank">
                <Icon name={social.icon} class="footer-social-icon" />
                <span class="sr-only">{social.title}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    )}

    {!footerEnabled && (
      <div class={`footer-no-content ${showProfilePicture && showSocialIcons ? 'footer-no-content--side' : ''}`}>
        {showProfilePicture ? (
          <div class="footer-profile-row">
            {profilePicture.url ? (
              <a href={profilePicture.url} class="footer-profile-link" target={profilePicture.url.startsWith('http') ? '_blank' : undefined} rel={profilePicture.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <img src={profilePicture.image} alt={profilePicture.alt} class={getProfilePictureClasses(profilePicture.size, profilePicture.style)} />
              </a>
            ) : (
              <img src={profilePicture.image} alt={profilePicture.alt} class={getProfilePictureClasses(profilePicture.size, profilePicture.style)} />
            )}
          </div>
        ) : null}
        {showSocialIcons && (
          <div class={`footer-social-icons ${showProfilePicture ? 'footer-social-icons--side' : 'footer-social-icons--center'}`}>
            {socialLinks.map((social) => (
              <a href={social.url} title={social.title} class="footer-social-link" target="_blank">
                <Icon name={social.icon} class="footer-social-icon" />
                <span class="sr-only">{social.title}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</footer>

<style>
  .site-footer {
    background-color: rgb(var(--color-primary-950));
    margin-top: auto;
    padding-block: 2rem;
  }

  .footer-profile-row {
    margin-bottom: 1rem;
    display: flex;
    justify-content: flex-start;
  }

  .footer-profile-link {
    display: inline-block;
    transition: opacity 0.2s;
  }

  .footer-profile-link:hover {
    opacity: 0.8;
  }

  .footer-profile-img {
    object-fit: cover;
  }

  .footer-profile-img--sm { height: 2rem; }
  .footer-profile-img--md { height: 3rem; }
  .footer-profile-img--lg { height: 4rem; }
  .footer-profile-img--circle {
    border-radius: 9999px;
    border: 2px solid rgb(var(--color-primary-700));
  }
  .footer-profile-img--square {
    border-radius: 0.5rem;
    border: 2px solid rgb(var(--color-primary-700));
  }
  .footer-profile-img--none {
    object-fit: contain;
  }

  .footer-social-mobile {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .footer-social-mobile { display: none; }
  }

  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-social-link {
    color: rgb(var(--color-primary-400));
    transition: color 0.2s;
  }

  .footer-social-link:hover {
    color: rgb(var(--color-highlight-400));
  }

  .footer-social-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .footer-content-row {
    text-align: center;
  }

  .footer-content-row--with-social {
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-content-row--with-social {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-content-text {
    font-size: 0.75rem;
    color: rgb(var(--color-primary-400));
    margin: 0;
  }

  .footer-social-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .footer-social-desktop {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }

  .footer-no-content {
    text-align: center;
  }

  .footer-no-content--side {
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-no-content--side {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-social-icons--center {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .footer-social-icons--side {
    display: none;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .footer-social-icons--side {
      display: flex;
      align-items: center;
    }
  }
</style>
