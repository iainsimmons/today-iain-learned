---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateMobile, processMarkdown, calculateReadingTime, getReadingTimeMobile } from '../utils/markdown';
import { siteConfig, getPostCardAspectRatio } from '../config';
import { getOptimizedFormat } from '@/utils/images';
import ImageWrapper from './ImageWrapper.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
  eager?: boolean;
  context?: 'featured' | 'recent' | 'posts' | 'tags';
}

const { post, featured = false, eager = false, context = 'posts' } = Astro.props;

const { excerpt, wordCount } = processMarkdown(post.body || '');
const readingTime = calculateReadingTime(post.body || '');

const { title, description, date, tags, image: rawImage, imageAlt } = post.data;
const id = post.id;

const image = (() => {
  if (!rawImage) return rawImage;
  let imageValue = rawImage;
  if (Array.isArray(rawImage)) {
    imageValue = rawImage[0];
  }
  if (typeof imageValue !== 'string') {
    return imageValue;
  }
  if (imageValue.startsWith('[[') && imageValue.endsWith(']]')) {
    return imageValue.slice(2, -2);
  }
  return imageValue;
})();

const shouldShowCoverImage = (() => {
  if (!image) return false;
  const showCoverImages = siteConfig.postOptions.showPostCardCoverImages;
  switch (showCoverImages) {
    case 'all': return true;
    case 'featured': return context === 'featured' || featured;
    case 'home': return context === 'featured' || context === 'recent';
    case 'posts': return context === 'posts' || context === 'tags';
    case 'featured-and-posts': return context === 'featured' || context === 'posts' || context === 'tags' || featured;
    case 'none': default: return false;
  }
})();
---

<article id={`post-article-${id}`} style={`view-transition-name: post-article-${id}`} class={`post-card ${featured ? 'post-card--featured' : ''} border-glow-top`} role="article" aria-labelledby={`post-title-${post.id}`}>
<div class="post-card-inner">
    {image && shouldShowCoverImage && (
      <div class="post-card-image-wrap" style={`aspect-ratio: ${getPostCardAspectRatio()};`}>
        <ImageWrapper
          src={(() => {
            let cleanImagePath = image;
            if (!cleanImagePath || typeof cleanImagePath !== 'string') return '';
            if (cleanImagePath.startsWith('[[') && cleanImagePath.endsWith(']]')) {
              cleanImagePath = cleanImagePath.slice(2, -2);
            }
            if (cleanImagePath.startsWith('http')) return cleanImagePath;
            const isFileBased = cleanImagePath.startsWith('attachments/');
            if (isFileBased) {
              cleanImagePath = cleanImagePath.replace('attachments/', '');
            } else {
              if (cleanImagePath.startsWith('images/') || cleanImagePath.startsWith('attachments/')) {
                cleanImagePath = cleanImagePath.replace(/^(images|attachments)\//, '');
              }
            }
            return getOptimizedFormat(cleanImagePath);
          })()}
          basePath={(() => {
            if (typeof image === 'string' && image.startsWith('http')) return '';
            let cleanImagePath = image;
            if (typeof cleanImagePath === 'string' && cleanImagePath.startsWith('[[') && cleanImagePath.endsWith(']]')) {
              cleanImagePath = cleanImagePath.slice(2, -2);
            }
            if (typeof cleanImagePath === 'string' && cleanImagePath.startsWith('attachments/')) {
              return '/posts/attachments/';
            }
            if (post.id) {
              return `/posts/${post.id}/`;
            } else {
              return '/posts/attachments/';
            }
          })()}
          alt={imageAlt || `Featured image for post: ${title}`}
          class="post-card-image"
          width={800}
          height={450}
          format="webp"
          quality={85}
          loading={featured || eager ? "eager" : "lazy"}
          fetchpriority={featured || eager ? "high" : "auto"}
        />
      </div>
    )}

    <div class={`post-card-body ${image && shouldShowCoverImage ? 'post-card-body--with-image' : ''}`}>
      <div class="post-card-meta">
        <time datetime={date.toISOString()}>
          <span class="post-card-date-desktop">{formatDate(date)}</span>
          <span class="post-card-date-mobile">{formatDateMobile(date)}</span>
        </time>

        {siteConfig.postOptions.readingTime && readingTime && (
          <>
            <span class="post-card-sep-desktop">•</span>
            <span class="post-card-sep-mobile">•</span>
            <span>
              <span class="post-card-rt-desktop">{readingTime.text && readingTime.text !== 'read0' && readingTime.text !== '' ? readingTime.text : '1 min read'}</span>
              <span class="post-card-rt-mobile">{getReadingTimeMobile(readingTime)}</span>
            </span>
          </>
        )}

        {siteConfig.postOptions.wordCount && wordCount !== undefined && (
          <>
            <span class="post-card-sep-desktop">•</span>
            <span class="post-card-sep-mobile">•</span>
            <span class="post-card-wc-wrap">
              <span class="post-card-wc-desktop">{wordCount === 1 ? '1 word' : `${wordCount} words`}</span>
              <span class="post-card-wc-mobile">{wordCount === 1 ? '1 word' : `${wordCount.toLocaleString()} words`}</span>
            </span>
          </>
        )}
      </div>

      <h3>
        <a href={`/posts/${post.id}`} class={`post-card-title ${featured ? 'post-card-title--featured' : ''}`}>
          {title}
        </a>
      </h3>

      {featured && description && (
        <p class="post-card-desc">{description}</p>
      )}

      {tags && tags.length > 0 && siteConfig.postOptions.tags && (
        <div class="post-card-tags">
          {tags.map((tag) => (
            <a href={`/posts/tag/${tag}`} class="post-card-tag" aria-label={`View posts tagged with ${tag}`}>
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .post-card {
    border: 1px solid rgb(var(--color-primary-700));
    background-color: rgb(var(--color-primary-900));
    border-radius: 0.5rem;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .post-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .post-card--featured {
    border-color: rgb(var(--color-highlight-700));
  }

  .post-card-inner {
    display: block;
  }

  .post-card-image-wrap {
    overflow: hidden;
    border-radius: 0.5rem 0.5rem 0 0;
    background-color: rgb(var(--color-primary-800));
  }

  .post-card-image {
    width: 100%;
    height: 100%;
    transition: all 0.3s;
  }

  .post-card:hover .post-card-image {
    transform: scale(1.02);
  }

  .post-card-body {
    padding: 1rem;
  }

  .post-card-body--with-image {
    border-radius: 0 0 0.5rem 0.5rem;
  }

  .post-card-body:not(.post-card-body--with-image) {
    border-radius: 0.5rem;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 0.25rem;
    font-size: 0.875rem;
    color: rgb(var(--color-primary-400));
    margin-bottom: 0.25rem;
  }

  .post-card-date-desktop { display: inline; }
  .post-card-date-mobile { display: none; }
  .post-card-sep-desktop { display: inline; color: rgb(var(--color-primary-600)); }
  .post-card-sep-mobile { display: none; }
  .post-card-rt-desktop { display: inline; }
  .post-card-rt-mobile { display: none; }
  .post-card-wc-wrap { min-width: 0; }
  .post-card-wc-desktop { display: inline; }
  .post-card-wc-mobile { display: none; }

  @media (max-width: 639px) {
    .post-card-date-desktop { display: none; }
    .post-card-date-mobile { display: inline; }
    .post-card-sep-desktop { display: none; }
    .post-card-sep-mobile { display: inline; color: rgb(var(--color-primary-600)); }
    .post-card-rt-desktop { display: none; }
    .post-card-rt-mobile { display: inline; }
    .post-card-wc-desktop { display: none; }
    .post-card-wc-mobile { display: inline; }
  }

  .post-card-title {
    font-weight: 500;
    color: rgb(var(--color-primary-100));
    line-height: 1.625;
    font-size: 1rem;
    transition: color 0.2s;
    text-decoration: none;
  }

  .post-card-title:hover {
    color: rgb(var(--color-highlight-400));
  }

  .post-card-title--featured {
    font-size: 1.125rem;
  }

  .post-card-desc {
    color: rgb(var(--color-primary-300));
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.625;
    margin-top: 0.25rem;
  }

  .post-card-tags {
    margin-top: 0.75rem;
  }

  .post-card-tag {
    display: inline-block;
    font-size: 0.75rem;
    color: rgb(var(--color-primary-300));
    background-color: rgb(var(--color-primary-800));
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--color-primary-700));
    transition: background-color 0.2s, color 0.2s;
    margin-right: 0.5rem;
    margin-bottom: 0.25rem;
    text-decoration: none;
  }

  .post-card-tag:hover {
    background-color: rgb(var(--color-highlight-800));
    color: rgb(var(--color-highlight-200));
  }
</style>
