---
import type { ImageInfo } from '@/types';
import { processImageLayout } from '@/utils/images';
import Icon from './Icon.astro';
import ImageWrapper from './ImageWrapper.astro';

export interface Props {
  images: ImageInfo[];
  layout?: 'single' | 'grid-2' | 'grid-3' | 'grid-4' | 'auto';
}

const { images, layout = 'auto' } = Astro.props;

const processedLayout = layout === 'auto' ? processImageLayout(images) : { layout, images };
const { layout: finalLayout, images: finalImages } = processedLayout;
---

{finalImages.length > 0 && (
  <div class={`image-gallery ${finalLayout}`}>
    {finalImages.map((image, index) => (
      <div class="image-item">
        <button 
          class="image-button"
          data-image-index={index}
          data-lightbox="gallery"
          aria-label={`View ${image.alt} in full size`}
        >
          <ImageWrapper
            src={image.src}
            basePath="/posts/attachments/"
            alt={image.alt}
            class="image-gallery-img"
            width={600}
            height={400}
            format="webp"
            quality={85}
            loading="lazy"
          />
          <div class="image-button-overlay">
            <Icon name="zoom-in" class="image-button-icon" />
          </div>
        </button>
      </div>
    ))}
  </div>
)}

<style>
  .image-gallery {
    display: grid;
    gap: 1rem;
  }
  
  .image-gallery.single {
    grid-template-columns: 1fr;
  }
  
  .image-gallery.grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .image-gallery.grid-3 {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .image-gallery.grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .image-gallery.grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .image-gallery.grid-4 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .image-gallery.grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .image-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  
  .image-button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .image-button .image-gallery-img {
    border-radius: 0.5rem;
    transition: all 300ms var(--default-easing);
  }
  
  .image-button:hover .image-gallery-img {
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    scale: 1.02;
  }

  .image-button-overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0);
    transition: background-color 300ms var(--default-easing);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-button:hover .image-button-overlay {
    background-color: rgb(0 0 0 / 0.1);
  }

  .image-button-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: rgb(255 255 255);
    opacity: 0;
    transition: opacity 300ms var(--default-easing);
  }

  .image-button:hover .image-button-icon {
    opacity: 1;
  }
  
  .image-gallery.grid-3 .image-item:first-child {
    grid-column: span 2;
  }
  
  .image-gallery.grid-4 .image-item:nth-child(4n+1) {
    aspect-ratio: 1 / 1;
  }
  
  .image-gallery.grid-4 .image-item:nth-child(4n+2) {
    aspect-ratio: 4 / 3;
  }
  
  .image-gallery.grid-4 .image-item:nth-child(4n+3) {
    aspect-ratio: 16 / 9;
  }
  
  .image-gallery.grid-4 .image-item:nth-child(4n) {
    aspect-ratio: 3 / 4;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const imageButtons = document.querySelectorAll('[data-lightbox="gallery"]');
    
    imageButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const imageIndex = parseInt(button.getAttribute('data-image-index') || '0');
        
        const event = new CustomEvent('openLightbox', {
          detail: { index: imageIndex }
        });
        window.dispatchEvent(event);
      });
      
      let pressTimer: number;
      
      button.addEventListener('touchstart', (e) => {
        pressTimer = window.setTimeout(() => {
          e.preventDefault();
          const imageIndex = parseInt(button.getAttribute('data-image-index') || '0');
          const event = new CustomEvent('openLightbox', {
            detail: { index: imageIndex }
          });
          window.dispatchEvent(event);
        }, 500);
      });
      
      button.addEventListener('touchend', () => {
        clearTimeout(pressTimer);
      });
      
      button.addEventListener('touchmove', () => {
        clearTimeout(pressTimer);
      });
    });
  });
</script>
