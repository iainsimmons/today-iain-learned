---
export interface Props {
  columns: string[];
  rows: Record<string, any>[];
}
const { columns, rows } = Astro.props as Props;
---
<div class="bt-wrapper">
  <table class="bt-table">
    <thead>
      <tr class="bt-header-row">
        {columns.map((col) => (
          <th class="bt-header-cell">{col}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="bt-row">
          {columns.map((col) => (
            <td class="bt-cell">{String(row[col] ?? '')}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .bt-wrapper {
    overflow-x: auto;
  }

  .bt-table {
    width: 100%;
    text-align: left;
    border-collapse: collapse;
  }

  .bt-header-row {
    border-bottom: 1px solid rgb(var(--color-primary-600));
  }

  .bt-header-cell {
    padding: 0.5rem 1rem 0.5rem 0;
    color: rgb(var(--color-primary-300));
    white-space: nowrap;
  }

  .bt-row {
    border-bottom: 1px solid rgb(var(--color-primary-600) / 0.6);
  }

  .bt-row:last-child {
    border-bottom: 0;
  }

  .bt-cell {
    padding: 0.5rem 1rem 0.5rem 0;
    color: rgb(var(--color-primary-100));
    white-space: nowrap;
  }
</style>
