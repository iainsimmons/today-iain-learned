---
import { siteConfig } from '@/config';
import Icon from './Icon.astro';

export interface Props {
  tags: string[];
  currentTag?: string;
  showCount?: boolean;
  variant?: 'default' | 'outline' | 'minimal';
}

const { tags, currentTag, showCount = false, variant = 'default' } = Astro.props;
const sortedTags = [...tags].sort();
---

{siteConfig.postOptions.tags && sortedTags.length > 0 && (
  <div class="tags-container">
    <h3 class="tags-heading">
      <Icon name="tag" class="tags-heading-icon" />
      Tags
    </h3>

    <div class="tags-list">
      {sortedTags.map(tag => (
        <a
          href={`/posts/tag/${encodeURIComponent(tag)}`}
          class={`tags-item ${currentTag === tag ? 'tags-item--active' : ''}`}
        >
          <span class="tags-item-text">{tag}</span>
          {showCount && (
            <span class="tags-item-count" />
          )}
        </a>
      ))}
    </div>
  </div>
)}

<style is:global>
  .tags-container {
    padding: 1rem;
    background-color: rgb(var(--color-primary-900));
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--color-primary-700));
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .tags-heading {
    font-weight: 600;
    color: rgb(var(--color-primary-50));
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    font-size: 0.875rem;
  }

  .tags-heading-icon {
    width: 1rem;
    height: 1rem;
    margin-right: 0.5rem;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags-item {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
    background-color: rgb(var(--color-primary-800));
    color: rgb(var(--color-primary-300));
    text-decoration: none;
  }

  .tags-item:hover {
    background-color: rgb(var(--color-primary-700));
    color: rgb(var(--color-primary-200));
  }

  .tags-item--active {
    background-color: rgb(var(--color-highlight-900) / 0.4);
    color: rgb(var(--color-highlight-200));
    outline: 1px solid rgb(var(--color-highlight-700));
  }

  .tags-item-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 8rem;
  }

  .tags-item-count {
    font-size: 0.75rem;
    opacity: 0.75;
    background-color: rgba(255, 255, 255, 0.2);
    padding: 0.125rem 0.375rem;
    border-radius: 9999px;
    margin-left: 0.25rem;
  }

  @media (max-width: 640px) {
    .tags-item {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }

    .tags-item-text {
      max-width: 6rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tagItems = document.querySelectorAll('.tags-item');
    tagItems.forEach(item => {
      item.addEventListener('click', (e) => {
        const tag = item.getAttribute('data-tag');
        if (tag) {
          window.dispatchEvent(new CustomEvent('tagClicked', {
            detail: { tag }
          }));
        }
      });
    });
  });
</script>
