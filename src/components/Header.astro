---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
---

<header id="main-header" class="site-header">
  <div class="container-inner">
    <div class="site-header-bar">
      <div class="site-header-brand">
        <a href="/">
          <span class="site-header-title">{siteConfig.title}</span>
        </a>
      </div>

      <div
        class={`site-header-nav-area ${siteConfig.navigation.style === "minimal" ? "site-header-nav-area--right" : "site-header-nav-area--center"}`}
      >
        {
          siteConfig.navigation.showNavigation && (
            <nav class="site-header-nav" aria-label="Main navigation">
              {siteConfig.navigation.pages.map((page) => (
                <a
                  href={page.url || "#"}
                  class="site-header-nav-link"
                  target={page.url?.startsWith("http") ? "_blank" : undefined}
                  aria-label={`Navigate to ${page.title}`}
                >
                  <span>
                    {siteConfig.navigation.style === "minimal"
                      ? page.title.toLowerCase()
                      : page.title}
                  </span>
                  {page.url?.startsWith("http") && (
                    <Icon
                      name="external-link"
                      class="site-header-ext-link"
                      size={12}
                    />
                  )}
                </a>
              ))}
            </nav>
          )
        }
      </div>

      <div class="site-header-actions">
        <button
          id="command-palette-trigger"
          command="show-modal"
          commandfor="command-palette-dialog"
          class="cmd-trigger"
          aria-label="Open command palette, menu, search"
        >
          <Icon name="menu" class="show-on-touch" size={20} />
          <kbd class="cmd-trigger-kbd narrow hide-on-touch">Ctrl</kbd>
          <span class="hide-on-touch">+</span>
          <kbd class="cmd-trigger-kbd hide-on-touch">K</kbd>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    width: 100%;
    background-color: rgb(var(--color-primary-950));
    transition: box-shadow 0.2s var(--default-easing);
  }

  .site-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .site-header-brand {
    display: flex;
    align-items: center;
  }

  .site-header-title {
    font-weight: 600;
    color: rgb(var(--color-primary-50));
    transition: color 0.2s;
  }

  .site-header-title:hover {
    color: rgb(var(--color-highlight-400));
  }

  .site-header-nav-area {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .site-header-nav-area--right {
    justify-content: flex-end;
  }

  .site-header-nav-area--center {
    justify-content: center;
  }

  .site-header-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .site-header-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-right: 1.5rem;
    }
  }

  .site-header-nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: rgb(var(--color-primary-300));
    transition: color 0.2s;
    text-decoration: none;
  }

  .site-header-nav-link:hover {
    color: rgb(var(--color-highlight-400));
  }

  :global(.site-header-ext-link) {
    width: 0.75rem;
    height: 0.75rem;
    color: rgb(var(--color-primary-500));
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cmd-trigger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: rgb(var(--color-primary-400));
    background-color: rgb(var(--color-primary-800));
    border-radius: 0.5rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .cmd-trigger:hover {
    background-color: rgb(var(--color-primary-700));
  }

  .cmd-trigger-simple {
    padding: 0.5rem;
    color: rgb(var(--color-primary-400));
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s;
  }

  .cmd-trigger-simple:hover {
    color: rgb(var(--color-primary-300));
  }

  .cmd-trigger-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .cmd-trigger-kbd {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(var(--color-primary-300));

    &.narrow {
      padding: 0.25rem;
      letter-spacing: -1px;
    }
  }
</style>
