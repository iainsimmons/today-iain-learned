---
import type { Post } from '@/types';
import { siteConfig } from '@/config';
import { generatePostSEO } from '@/utils/seo';
import { optimizePostImagePath, getOptimizedFormat } from '@/utils/images';
import { getCollection } from 'astro:content';
import { shouldShowPost, processPost, calculateReadingTime, generateTOC, getAdjacentPosts, formatDate, formatDateMobile, getReadingTimeMobile } from '@/utils/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import LinkedMentions from '@/components/LinkedMentions.astro';
import GiscusComments from '@/components/GiscusComments.astro';
import Icon from '@/components/Icon.astro';
import ImageWrapper from '@/components/ImageWrapper.astro';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const id = post.id;

// Check if we're in development mode
const isDev = import.meta.env.DEV;

// Generate SEO data
const seoData = generatePostSEO(post, import.meta.env.SITE || '');



// Generate structured data for the post
const structuredData = {
  "@context": "https://schema.schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": siteConfig.author
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.title,
    "logo": {
      "@type": "ImageObject",
      "url": siteConfig.site + "/favicon.ico"
    }
  },
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};

// Get all posts for wikilink resolution
const allPosts = await getCollection('posts');
const visiblePosts = allPosts.filter(p => shouldShowPost(p, isDev));

// Process the post content and get processed data including word count
const { Content, headings, wordCount, remarkPluginFrontmatter } = await processPost(post);
const readingTime = calculateReadingTime(post.body);

// Generate table of contents if enabled
const hideTOC = post.data.hideTOC === true;
const shouldShowTOC = !hideTOC && siteConfig.tableOfContents.enabled && headings.length > 0;
const toc = shouldShowTOC ? await generateTOC(headings) : [];

// Get adjacent posts for navigation
const { prev: prevPost, next: nextPost } = getAdjacentPosts(visiblePosts, post.id);

const showCoverImage = siteConfig.postOptions.showPostCardCoverImages !== 'none' && post.data.image && post.data.hideCoverImage !== true;

---

<BaseLayout seoData={seoData} hasTOC={shouldShowTOC}>
  <Fragment slot="head">
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Preload post cover image - only for posts that will definitely show the image immediately -->
    {(() => {
      if (!post.data.image || post.data.hideCoverImage === true) return false;

      const showCoverImages = siteConfig.postOptions.showPostCardCoverImages;
      // Only preload for posts that are likely to show the image immediately
      // Skip preload for complex posts that might have delayed rendering
      const shouldPreload = ['all', 'posts', 'featured-and-posts'].includes(showCoverImages) &&
                           post.id !== 'formatting-reference';

      return shouldPreload;
    })() && (
      <link
        rel="preload"
        as="image"
        href={post.data.image?.startsWith('http') ? post.data.image : (post.data.image ? optimizePostImagePath(post.data.image, post.id, post.id) : '')}
        fetchpriority="high"
      />
    )}

    <!-- Post-specific meta tags -->
    {post.data.targetKeyword && (
      <meta name="keywords" content={post.data.targetKeyword}>
    )}
  </Fragment>

  <div class="layout-wrapper">
      <!-- Main content -->
      <article id={`post-article-${id}`} style={`view-transition-name: post-article-${id}`} class={`border-glow-top border-glow-top-permanent layout-article ${showCoverImage ? 'layout-article--cover' : ''}`}>
        {/* Cover image - shown if global config allows and not hidden by frontmatter */}
        {showCoverImage && (() => {
          // Process image path similar to PostCard
          let rawImage = post.data.image;
          if (Array.isArray(rawImage)) {
            rawImage = rawImage[0];
          }
          
          // Clean Obsidian brackets
          let cleanImagePath = typeof rawImage === 'string' ? rawImage : '';
          if (cleanImagePath.startsWith('[[') && cleanImagePath.endsWith(']]')) {
            cleanImagePath = cleanImagePath.slice(2, -2);
          }
          
          // Determine src and basePath for ImageWrapper
          let imageSrc = cleanImagePath;
          let imageBasePath = '';
          
          if (typeof cleanImagePath === 'string' && cleanImagePath.startsWith('http')) {
            // External URL - pass as-is
            imageSrc = cleanImagePath;
            imageBasePath = '';
          } else {
            // Detect folder-based vs file-based: if image path starts with 'attachments/',
            // it's a single-file post (shared attachments folder)
            const isFileBased = typeof cleanImagePath === 'string' && cleanImagePath.startsWith('attachments/');
            
            if (isFileBased) {
              // Single-file post - remove attachments/ prefix
              imageSrc = cleanImagePath.replace('attachments/', '');
              imageBasePath = '/posts/attachments/';
            } else {
              // Folder-based post - sync script copies images to post folder root
              // Remove 'images/' or 'attachments/' prefixes if present (sync script removes them)
              if (cleanImagePath.startsWith('images/') || cleanImagePath.startsWith('attachments/')) {
                imageSrc = cleanImagePath.replace(/^(images|attachments)\//, '');
              } else {
                imageSrc = cleanImagePath;
              }
              // Safety check: ensure post.id exists before using it
              if (post.id) {
                imageBasePath = `/posts/${post.id}/`;
              } else {
                // Fallback to attachments directory if post.id is undefined
                imageBasePath = '/posts/attachments/';
              }
            }
          }
          
          // Convert to WebP if applicable (sync-images.js creates WebP versions)
          imageSrc = getOptimizedFormat(imageSrc);
          
          return (
            <div class="pol-image-wrap">
              <ImageWrapper
                src={imageSrc}
                basePath={imageBasePath}
                alt={post.data.imageAlt || `Featured image for post: ${post.data.title}`}
                class="pol-image"
                width={800}
                height={450}
                format="webp"
                quality={85}
                loading="eager"
                fetchpriority="high"
              />
            </div>
          );
        })()}

        <!-- Post content wrapper -->
        <div class={`pol-content ${showCoverImage ? 'pol-content--cover' : 'pol-content--no-cover'}`}>
          <!-- Post header -->
          <header class="pol-header">
            <h1 class="pol-title">
            {post.data.title}
          </h1>

          <div class="pol-meta">
            <time datetime={post.data.date.toISOString()} class="pol-meta-date">
              <span class="pol-desktop">
                {formatDate(post.data.date)}
              </span>
              <span class="pol-mobile">
                {formatDateMobile(post.data.date)}
              </span>
            </time>

            {siteConfig.postOptions.readingTime && readingTime && (
              <>
                <span class="pol-sep-desktop">•</span>
                <span class="pol-sep-mobile">•</span>
                <span>
                  <span class="pol-desktop">{readingTime.text && readingTime.text !== 'read0' && readingTime.text !== '' ? readingTime.text : '1 min read'}</span>
                  <span class="pol-mobile">{getReadingTimeMobile(readingTime)}</span>
                </span>
              </>
            )}

            {siteConfig.postOptions.wordCount && wordCount !== undefined && (
              <>
                <span class="pol-sep-desktop">•</span>
                <span class="pol-sep-mobile">•</span>
                <span class="pol-meta-value-wrap">
                  <span class="pol-desktop">{wordCount === 1 ? '1 word' : `${wordCount} words`}</span>
                  <span class="pol-mobile">{wordCount === 1 ? '1 word' : `${wordCount.toLocaleString()} words`}</span>
                </span>
              </>
            )}
          </div>

          {siteConfig.postOptions.tags && post.data.tags && post.data.tags.length > 0 && (
            <div class="pol-tags">
              {post.data.tags.map(tag => (
                <a
                  href={`/posts/tag/${encodeURIComponent(tag)}`}
                  class="pol-tag"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <!-- Article content -->
        <div class="prose" id="post-content">
          <Content />
        </div>

        {siteConfig.postOptions.linkedMentions.enabled && (
          <LinkedMentions currentSlug={post.id} />
        )}

        <!-- Post navigation -->
        {siteConfig.postOptions.postNavigation && (prevPost || nextPost) && (
          <nav class={`pol-nav ${!siteConfig.postOptions.linkedMentions.enabled ? 'pol-nav-border' : ''}`}>
            <div class="pol-nav-grid">
              {prevPost && (
                <div class="pol-nav-cell">
                  <a
                    href={`/posts/${prevPost.id}`}
                    class="pol-nav-card"
                  >
                    <h3 class="pol-nav-title">
                      {prevPost.data.title}
                    </h3>
                    <div class="pol-nav-left">
                      <Icon name="arrow-left" class="pol-nav-icon" />
                    </div>
                  </a>
                </div>
              )}

              {nextPost && (
                <div class={`pol-nav-cell--right ${!prevPost ? 'pol-nav-cell--col2' : ''}`}>
                  <a
                    href={`/posts/${nextPost.id}`}
                    class="pol-nav-card"
                  >
                    <h3 class="pol-nav-title">
                      {nextPost.data.title}
                    </h3>
                    <div class="pol-nav-right">
                      <Icon name="arrow-right" class="pol-nav-icon" />
                    </div>
                  </a>
                </div>
              )}
            </div>
          </nav>
        )}

        <!-- Giscus Comments -->
        {siteConfig.postOptions.comments.enabled && (
          <div class="pol-comments">
            <GiscusComments
              postTitle={post.data.title}
              postSlug={post.id}
              postUrl={Astro.url.href}
            />
          </div>
        )}
        </div>
      </article>

      <!-- Desktop Sidebar - floats to the right of the content container -->
      <div class="layout-sidebar">
        <div class={`layout-sidebar-inner ${shouldShowTOC ? 'layout-sidebar-inner--toc' : ''}`} id="sidebar">
          {shouldShowTOC && (
            <div id="toc">
              <TableOfContents headings={toc} />
            </div>
          )}
        </div>
      </div>
    </div>

  <Fragment slot="scripts">
    <script define:vars={{ posts: visiblePosts, commentsEnabled: siteConfig.postOptions.comments.enabled, postTitle: post.data.title, postSlug: post.id }}>

      // Process wikilinks - unified logic for all wikilink types
      function initializeWikilinks() {
        const wikilinks = document.querySelectorAll('.wikilink[data-wikilink]');

        wikilinks.forEach(link => {
          const linkText = link.dataset.wikilink;
          
          // Skip same-page anchors (empty data-wikilink) - they're already properly formatted
          if (!linkText || linkText === '') {
            return;
          }
          
          const displayOverride = link.dataset.displayOverride;
          const currentDisplayText = link.textContent;

          // Find the matching post - use id (not slug, which is deprecated in Astro v6)
          const slug = linkText.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');

          // Helper function to create slug from title (same as resolveWikilink logic)
          const createSlugFromTitle = (title) => {
            return title.toLowerCase()
              .replace(/[^a-z0-9\s-]/g, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '');
          };

          // First try exact id match (Astro v6 uses id, not slug)
          let post = posts.find(p => p.id === slug);
          
          // If not found, try title match (for wikilinks that use post titles)
          if (!post) {
            post = posts.find(p => createSlugFromTitle(p.data.title) === slug);
          }

          if (post) {
            // Update href - preserve anchor if present
            const currentHref = link.href || link.getAttribute('href') || '';
            const anchorMatch = currentHref.match(/#(.+)$/);
            const anchor = anchorMatch ? anchorMatch[1] : null;
            
            if (anchor) {
              link.href = `/posts/${post.id}#${anchor}`;
            } else {
              link.href = `/posts/${post.id}`;
            }

            // Simple logic:
            // - If displayOverride exists and is not null, it's a wikilink with custom text [[link|display]] - use it
            // - If displayOverride is null/undefined, it's a standard markdown link [text](url) - NEVER change the text
            // - If displayOverride is empty string, it's a naked wikilink [[link]] - use post title

            if (displayOverride && displayOverride !== 'null' && displayOverride !== 'undefined') {
              // Wikilink with custom display: [[link|display]]
              link.textContent = displayOverride;
            } else if (displayOverride === 'null' || displayOverride === null || displayOverride === 'undefined' || displayOverride === undefined) {
              // Standard markdown link: [text](url) - NEVER change the display text
              // Keep currentDisplayText as-is
            } else {
              // Naked wikilink: [[link]] - use post title
              link.textContent = post.data.title;
            }
          } else {
            // Mark as broken link
            link.classList.add('wikilink-broken');
            link.title = 'Link not found';
          }
        });
      }

      window.initializeWikilinks = initializeWikilinks;

      // Process wikilinks and initialize layouts after content loads
      document.addEventListener('DOMContentLoaded', () => {
        // Process external links - handled by BaseLayout, but call here as backup for initial load
        if (window.processExternalLinks) {
          window.processExternalLinks();
        }

        // Initialize wikilinks on initial load
        initializeWikilinks();
      });

      // External links are now handled globally by BaseLayout

    </script>
  </Fragment>

  <!-- Lightbox is handled globally by BaseLayout -->
</BaseLayout>

<style is:global>
  /* Layout wrapper */
  .pol-wrapper {
    padding-top: 2rem;
    padding-bottom: 2rem;
    position: relative;
  }

  /* Container */
  .pol-container {
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .pol-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .pol-container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  /* Article card */
  .pol-article {
    background-color: rgb(var(--color-primary-900));
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--color-primary-700));
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }

  /* Image wrapper */
  .pol-image-wrap {
    height: 10rem;
    overflow: hidden;
    border-top-left-radius: 0.5rem;
    border-top-right-radius: 0.5rem;
    background-color: rgb(var(--color-primary-800));
  }

  @media (min-width: 640px) {
    .pol-image-wrap {
      height: 12rem;
    }
  }

  @media (min-width: 768px) {
    .pol-image-wrap {
      height: 14rem;
    }
  }

  @media (min-width: 1024px) {
    .pol-image-wrap {
      height: 16rem;
    }
  }

  /* Image */
  .pol-image {
    width: 100%;
    height: 100%;
  }

  /* Content */
  .pol-content {
    padding: 1.5rem;
  }

  .pol-content--cover {
    border-bottom-left-radius: 0.5rem;
    border-bottom-right-radius: 0.5rem;
  }

  .pol-content--no-cover {
    border-radius: 0.5rem;
  }

  /* Post header */
  .pol-header {
    margin-bottom: 1rem;
  }

  /* Title */
  .pol-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgb(var(--color-primary-50));
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }

  /* Meta row */
  .pol-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.5rem;
    font-size: 0.875rem;
    color: rgb(var(--color-primary-300));
    margin-bottom: 1.5rem;
  }

  .pol-meta-date {
    font-weight: 500;
  }

  /* Desktop-only */
  .pol-desktop {
    display: none;
  }

  @media (min-width: 640px) {
    .pol-desktop {
      display: inline;
    }
  }

  /* Mobile-only */
  .pol-mobile {
    display: inline;
  }

  @media (min-width: 640px) {
    .pol-mobile {
      display: none;
    }
  }

  /* Separator desktop */
  .pol-sep-desktop {
    color: rgb(var(--color-primary-600));
    display: none;
  }

  @media (min-width: 640px) {
    .pol-sep-desktop {
      display: inline;
    }
  }

  /* Separator mobile */
  .pol-sep-mobile {
    color: rgb(var(--color-primary-600));
    display: inline;
  }

  @media (min-width: 640px) {
    .pol-sep-mobile {
      display: none;
    }
  }

  /* Meta value wrap */
  .pol-meta-value-wrap {
    min-width: 0;
  }

  /* Tags container */
  .pol-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  /* Tag link */
  .pol-tag {
    font-size: 0.75rem;
    color: rgb(var(--color-primary-300));
    background-color: rgb(var(--color-primary-800));
    padding-left: 0.625rem;
    padding-right: 0.625rem;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    border-radius: 9999px;
    border: 1px solid rgb(var(--color-primary-700));
    transition: background-color 0.2s, color 0.2s;
  }

  .pol-tag:hover {
    background-color: rgb(var(--color-highlight-800));
  }

  /* Post navigation container */
  .pol-nav {
    margin-top: 2rem;
    padding-top: 2rem;
  }

  .pol-nav-border {
    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: rgb(var(--color-primary-700));
  }

  /* Navigation grid */
  .pol-nav-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .pol-nav-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Nav cards */
  .pol-nav-card {
    display: block;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--color-primary-700));
    transition: all 200ms ease;
  }

  .pol-nav-card:hover {
    border-color: rgb(var(--color-highlight-600));
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  /* Nav titles */
  .pol-nav-title {
    font-weight: 600;
    font-size: 1rem;
    color: rgb(var(--color-primary-50));
    transition: color 0.2s;
  }

  .pol-nav-card:hover .pol-nav-title {
    color: rgb(var(--color-highlight-400));
  }

  /* Nav icons */
  .pol-nav-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: rgb(var(--color-primary-400));
    transition: color 0.2s;
  }

  .pol-nav-card:hover .pol-nav-icon {
    color: rgb(var(--color-highlight-400));
  }

  /* Nav flex */
  .pol-nav-left {
    display: flex;
    justify-content: flex-start;
    margin-top: 0.5rem;
  }

  .pol-nav-right {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  /* Nav cells */
  .pol-nav-cell {
    text-align: left;
  }

  .pol-nav-cell--right {
    text-align: right;
  }

  @media (min-width: 768px) {
    .pol-nav-cell--col2 {
      grid-column-start: 2;
    }
  }

  /* Sidebar */
  .pol-sidebar {
    display: none;
    position: absolute;
    top: 0;
    left: 100%;
    margin-left: 0.25rem;
    width: 280px;
  }

  @media (min-width: 1280px) {
    .pol-sidebar {
      display: block;
    }
  }

  .pol-sidebar-inner {
    top: 6rem;
  }

  .pol-sidebar-inner--toc > * + * {
    margin-top: 1rem;
  }

  /* Comments */
  .pol-comments {
    margin-top: 4rem;
  }
</style>
