---
import { Font } from "astro:assets";
import { siteConfig } from "@/config";
import type { AtProtoLinks, SEOData } from "@/types";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import ScrollToTop from "@/components/ScrollToTop.astro";
import Lightbox from "@/components/Lightbox.astro";
import ImageGalleryManager from "@/components/ImageGalleryManager.astro";
import "@/styles/global.css";

export interface Props {
  atProtoLinks: AtProtoLinks;
  seoData: SEOData;
  bodyClass?: string;
  hasTOC?: boolean;
}

const { atProtoLinks = [], seoData, bodyClass = "", hasTOC } = Astro.props;

// Determine scrollbar class based on configuration
const scrollbarClass = siteConfig.hideScrollBar ? "" : "show-scrollbars";
---

<!doctype html>
<html lang={siteConfig.language} class={scrollbarClass} data-theme="obsidian">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{seoData.title}</title>
    <meta name="description" content={seoData.description} />
    <link rel="canonical" href={seoData.canonical} />

    {seoData.noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={seoData.title} />
    <meta property="og:description" content={seoData.description} />
    <meta property="og:url" content={seoData.canonical} />
    <meta property="og:type" content={seoData.ogType} />
    <meta property="og:site_name" content={siteConfig.title} />

    {
      seoData.ogImage ? (
        <>
          <meta property="og:image" content={seoData.ogImage.url} />
          <meta property="og:image:alt" content={seoData.ogImage.alt} />
          <meta
            property="og:image:width"
            content={seoData.ogImage.width.toString()}
          />
          <meta
            property="og:image:height"
            content={seoData.ogImage.height.toString()}
          />
        </>
      ) : (
        <>
          <meta property="og:image" content="/open-graph.png" />
          <meta
            property="og:image:alt"
            content={siteConfig.defaultOgImageAlt}
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoData.title} />
    <meta name="twitter:description" content={seoData.description} />
    {
      seoData.ogImage ? (
        <>
          <meta name="twitter:image" content={seoData.ogImage.url} />
          <meta name="twitter:image:alt" content={seoData.ogImage.alt} />
        </>
      ) : (
        <>
          <meta name="twitter:image" content="/open-graph.png" />
          <meta
            name="twitter:image:alt"
            content={siteConfig.defaultOgImageAlt}
          />
        </>
      )
    }

    {
      seoData.ogType === "article" && (
        <>
          {seoData.publishedTime && (
            <meta
              property="article:published_time"
              content={seoData.publishedTime}
            />
          )}
          {seoData.modifiedTime && (
            <meta
              property="article:modified_time"
              content={seoData.modifiedTime}
            />
          )}
          {seoData.tags &&
            seoData.tags.map((tag) => (
              <meta property="article:tag" content={tag} />
            ))}
        </>
      )
    }

    <link rel="icon" href="/favicon.png" />

    {atProtoLinks.map(({ rel, href }) => <link rel={rel} href={href} />)}

    <Font cssVariable="--font-jetbrains-mono" />

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 50;
        padding: 0.5rem 1rem;
        background-color: rgb(var(--color-highlight-600));
        color: white;
        border-radius: 0.375rem;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }
      .main-content {
        max-width: var(--container-max-width, 45rem);
        margin: 0 auto;
        padding-block: 2rem;
        position: relative;
        min-height: calc(100vh - 4rem);
      }
    </style>

    <slot name="head" />
    <script>
      import "invokers-polyfill";
    </script>
  </head>

  <body class={`${scrollbarClass} ${bodyClass}`}>
    <a href="#main-content" class="skip-link"> Skip to main content </a>
    {
      hasTOC && (
        <a href="#toc" class="skip-link">
          Skip to table of contents
        </a>
      )
    }

    <Header />

    <main id="main-content" class="main-content container-inner">
      <slot />
    </main>

    <Footer />

    {siteConfig.commandPalette.enabled && <CommandPalette />}

    {siteConfig.scrollToTop && <ScrollToTop />}

    <ImageGalleryManager />

    <script
      define:vars={{ commentsEnabled: siteConfig.postOptions.comments.enabled }}
      defer
    >
      // Set window.commentsEnabled for client-side access
      window.commentsEnabled = commentsEnabled;

      // Command Palette Keyboard Shortcut Handler
      function setupCommandPaletteShortcut() {
        // Add global keyboard listener
        document.addEventListener("keydown", (e) => {
          // Check modifiers with cross-platform primary mapping (Ctrl on Win/Linux, Cmd on macOS)
          const primaryPressed = e.ctrlKey;

          // Check if the key matches (case insensitive)
          const keyMatch = e.key.toLowerCase() === "k";

          // Only trigger if we're not in an input field, textarea, or contenteditable
          const isInputField =
            e.target.tagName === "INPUT" ||
            e.target.tagName === "TEXTAREA" ||
            e.target.contentEditable === "true" ||
            e.target.isContentEditable;

          if (primaryPressed && keyMatch && !isInputField) {
            e.preventDefault();
            e.stopPropagation();

            // Dispatch the openCommandPalette event
            const event = new CustomEvent("openCommandPalette");
            window.dispatchEvent(event);
          }
        });
      }

      // Setup command palette shortcut when DOM is ready
      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          setupCommandPaletteShortcut,
        );
      } else {
        setupCommandPaletteShortcut();
      }
    </script>

    <Lightbox />

    <slot name="scripts" />
  </body>
</html>
