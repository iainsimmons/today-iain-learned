{
  "name": "today-iain-learned",
  "version": "0.7.8",
  "description": "A flexible blog theme designed for Obsidian users.",
  "keywords": [
    "astro",
    "blog",
    "obsidian",
    "theme"
  ],
  "license": "MIT",
  "author": "David V. Kimball",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env ASTRO_CONTENT_COLLECTION_CACHE=false node scripts/setup-dev.mjs && node scripts/sync-images.js && node scripts/process-aliases.js && node scripts/generate-graph-data.js && astro dev --host 0.0.0.0",
    "build": "node scripts/sync-images.js && node scripts/process-aliases.js && node scripts/generate-graph-data.js && astro build && node scripts/post-build.js",
    "preview": "astro preview --host 0.0.0.0",
    "bluesky": "sequoia publish && node --env-file=.env scripts/extract-bsky-posts.js",
    "bluesky-dry-run": "sequoia publish --dry-run && node --env-file=.env scripts/extract-bsky-posts.js",
    "sync-images": "node scripts/sync-images.js",
    "process-aliases": "node scripts/process-aliases.js",
    "generate-graph-data": "node scripts/generate-graph-data.js",
    "check-images": "node scripts/check-missing-images.js",
    "version": "node scripts/get-version.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/compiler-rs": "^0.4.0",
    "@astrojs/markdown-satteri": "^0.4.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@types/d3": "^7.4.3",
    "astro": "7.3.1",
    "astro-expressive-code": "^0.44.0",
    "astro-redirect-from": "^1.3.3",
    "d3": "^7.9.0",
    "fuse.js": "^7.1.0",
    "invokers-polyfill": "^1.0.3",
    "lucide": "^0.542.0",
    "satteri": "^0.9.4",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.9",
    "@atproto/syntax": "^0.6.1",
    "@types/hast": "^3.0.4",
    "@types/unist": "^3.0.3",
    "cross-env": "^10.0.0",
    "fast-xml-parser": "^5.7.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "vite": "^7.1.12",
    "wrangler": "^4.129.0"
  }
}
